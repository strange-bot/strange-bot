<% function generateCheckbox(id, label, description, isChecked) { %>
  <div class="mb-3 flex items-center justify-between">
    <div class="flex flex-grow flex-col">
      <div class="mb-1 text-sm font-semibold text-gray-900 dark:text-white"><%= label %></div>
      <div class="text-sm font-normal text-gray-500 dark:text-gray-400">
        <%= description %>
      </div>
    </div>
    <label for="<%= id %>" class="relative flex cursor-pointer items-center">
      <% if (isChecked) { %>
        <input type="checkbox" name="<%= id %>" id="<%= id %>" class="sr-only" checked />
      <% } else { %>
        <input type="checkbox" name="<%= id %>" id="<%= id %>" class="sr-only" />
      <% } %>
      <span class="toggle-bg h-6 w-11 rounded-full border border-gray-200 bg-gray-200 dark:border-gray-600 dark:bg-gray-700"></span>
    </label>
  </div>
<% } %>


<section>
  <div class="grid gap-4 xl:grid-cols-2">
    <!-- START: Col 1 (Basic Settings)-->
    <div
      class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-gray-800 sm:p-6 2xl:col-span-2">
      <!-- START: Card Header -->
      <div class="mb-4 flex items-center justify-between border-b border-gray-200 pb-4 dark:border-gray-700">
        <h3 class="text-lg font-semibold text-gray-800 dark:text-white"><%= tr("automod:DASH.BASIC_TITLE") %></h3>
      </div>
      <!-- END: Card Header -->

      <form method="post">
        <!-- START: Card Body -->
        <div>
          <div class="mb-3">
            <div class="mb-2">
              <label for="log_channel" class="text-sm font-semibold text-gray-900 dark:text-white"><%= tr("automod:DASH.LOGS_TITLE") %></label>
              <div class="text-sm font-normal text-gray-500 dark:text-gray-400">
                <%= tr("automod:DASH.LOGS_DESC") %>
              </div>
            </div>
            <select name="log_channel" id="log_channel" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500">
              <option selected value><%= tr("common:DASH.CHANNEL_SELECT") %></option>
              <% guild.channels.cache.filter((ch) => ch.type === 0).map((ch) => { %>
                <option value="<%= ch.id %>" <%= settings.log_channel === ch.id ? 'selected' : '' %>><%= ch.name %></option>
              <% }) %>
            </select>
          </div>

          <div class="mb-3">
            <div class="mb-2">
              <label for="max_strikes" class="text-sm font-semibold text-gray-900 dark:text-white"><%= tr("automod:DASH.STRIKES_TITLE") %></label>
              <div class="text-sm font-normal text-gray-500 dark:text-gray-400">
                <%= tr("automod:DASH.STRIKES_DESC") %>
              </div>
            </div>
            <input
              type="number"
              min="0"
              max="20"
              name="max_strikes"
              class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-gray-900 shadow-sm focus:border-primary-500 focus:ring-primary-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 dark:focus:border-primary-500 dark:focus:ring-primary-500 sm:text-sm"
              value="<%= settings.strikes %>"
              />
          </div>

          <div class="mb-3">
            <div class="mb-2">
              <label for="automod_action" class="text-sm font-semibold text-gray-900 dark:text-white"><%= tr("automod:DASH.ACTION_TITLE") %></label>
              <div class="text-sm font-normal text-gray-500 dark:text-gray-400">
                <%= tr("automod:DASH.ACTION_DESC") %>
              </div>
            </div>
            <select name="automod_action" id="automod_action" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500">
              <option selected="selected"><%= settings.action %></option>
              <% if(settings.action !== "TIMEOUT") { %>
              <option>TIMEOUT</option>
              <% } %> <% if(settings.action !== "KICK") { %>
              <option>KICK</option>
              <% } %> <% if(settings.action !== "BAN") { %>
              <option>BAN</option>
              <% } %>
            </select>
          </div>

          <div class="mb-3">
            <div class="mb-2">
              <label for="log_embed" class="text-sm font-semibold text-gray-900 dark:text-white"><%= tr("automod:DASH.LOG_EMBED_TITLE") %></label>
              <div class="text-sm font-normal text-gray-500 dark:text-gray-400">
                <%= tr("automod:DASH.LOG_EMBED_DESC") %>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <input
                type="color"
                id="log_embed"
                name="log_embed"
                class="block w-full h-full min-h-10 rounded-lg border border-gray-300 p-0.5 text-gray-900 shadow-sm focus:border-primary-500 focus:ring-primary-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 dark:focus:border-primary-500 dark:focus:ring-primary-500 sm:text-sm"
                value="<%= settings.embed_colors.log %>"
              />
            </div>
          </div>

          <div class="mb-3">
            <div class="mb-2">
              <label for="dm_embed" class="text-sm font-semibold text-gray-900 dark:text-white"><%= tr("automod:DASH.DM_EMBED_TITLE") %></label>
              <div class="text-sm font-normal text-gray-500 dark:text-gray-400">
                <%= tr("automod:DASH.DM_EMBED_DESC") %>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <input
                type="color"
                id="dm_embed"
                name="dm_embed"
                class="block w-full h-full min-h-10 rounded-lg border border-gray-300 p-0.5 text-gray-900 shadow-sm focus:border-primary-500 focus:ring-primary-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 dark:focus:border-primary-500 dark:focus:ring-primary-500 sm:text-sm"
                value="<%= settings.embed_colors.dm %>"
              />
            </div>
          </div>

          <div class="mb-3">
            <div class="mb-2">
              <label for="wh_channels" class="text-sm font-semibold text-gray-900 dark:text-white"><%= tr("automod:DASH.WHITELIST_CH_TITLE") %></label>
              <div class="text-sm font-normal text-gray-500 dark:text-gray-400">
                <%= tr("automod:DASH.WHITELIST_CH_DESC") %>
              </div>
            </div>
            <select multiple name="wh_channels" id="wh_channels" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500">
              <option><%= tr("common:DASH.CHANNEL_SELECT") %></option>
              <% guild.channels.cache.filter((ch) => ch.type === 0).map((ch) => { %>
                <option value="<%= ch.id %>" <%= settings.wh_channels.includes(ch.id) ? 'selected' : '' %>><%= ch.name %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <!-- END: Card Body -->

        <!-- START: Card Footer -->
        <div class="mt-4 flex items-center justify-between border-t border-gray-200 pt-3 dark:border-gray-700 sm:pt-6">
          <div></div>
          <div class="flex-shrink-0">
            <button
              type="submit"
              name="basic_settings"
              class="inline-flex items-center rounded-lg bg-primary-700 px-3 py-2 text-center text-sm font-medium text-white hover:bg-primary-800 focus:outline-none focus:ring-4 focus:ring-primary-300 dark:bg-primary-600 dark:hover:bg-primary-700 dark:focus:ring-primary-800">
              <%= tr("common:DASH.UPDATE_ALL") %>
            </button>
          </div>
        </div>
        <!-- END: Card Footer -->
      </form>
    </div>
    <!-- END: Col 1 -->

    <!-- START: Col 2 (Quick Toggle) -->
    <div
      class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-gray-800 sm:p-6 2xl:col-span-2">
      <!-- START: Card Header -->
      <div class="mb-4 flex items-center justify-between border-b border-gray-200 pb-4 dark:border-gray-700">
        <h3 class="text-lg font-semibold text-gray-800 dark:text-white"><%= tr("automod:DASH.TOGGLE_TITLE") %></h3>
      </div>
      <!-- END: Card Header -->

      <form method="post">
        <!-- START: Card Body -->
        <div>
          <% generateCheckbox('debug', tr("automod:DASH.DEBUG_TITLE"), tr("automod:DASH.DEBUG_DESC"), settings.debug) %>
          <% generateCheckbox('anti_attachments', tr("automod:DASH.ATTACH_TITLE"), tr("automod:DASH.ATTACH_DESC"), settings.anti_attachments) %>
          <% generateCheckbox('anti_invites', tr("automod:DASH.INVITES_TITLE"), tr("automod:DASH.INVITES_DESC"), settings.anti_invites) %>
          <% generateCheckbox('anti_links', tr("automod:DASH.LINKS_TITLE"), tr("automod:DASH.LINKS_DESC"), settings.anti_links) %>
          <% generateCheckbox('anti_spam', tr("automod:DASH.SPAM_TITLE"), tr("automod:DASH.SPAM_DESC"), settings.anti_spam) %>
          <% generateCheckbox('anti_ghostping', tr("automod:DASH.GHOST_TITLE"), tr("automod:DASH.GHOST_DESC"), settings.anti_ghostping) %>
          <% generateCheckbox('anti_massmention', tr("automod:DASH.MASSMENTION_TITLE"), tr("automod:DASH.MASSMENTION_DESC"), settings.anti_massmention) %>
          <div class="mb-3">
            <div class="mb-2">
              <div class="text-sm font-semibold text-gray-900 dark:text-white"><%= tr("automod:DASH.MAXLINES_TITLE") %></div>
              <div class="text-sm font-normal text-gray-500 dark:text-gray-400">
                <%= tr("automod:DASH.MAXLINES_DESC") %>
              </div>
            </div>
            <input
              type="number"
              min="0"
              max="20"
              name="max_lines"
              class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-gray-900 shadow-sm focus:border-primary-500 focus:ring-primary-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 dark:focus:border-primary-500 dark:focus:ring-primary-500 sm:text-sm"
              value="<%= settings.max_lines %>"
              />
          </div>
        </div>
        <!-- END: Card Body -->

        <!-- START: Card Footer -->
        <div class="mt-4 flex items-center justify-between border-t border-gray-200 pt-3 dark:border-gray-700 sm:pt-6">
          <div></div>
          <div class="flex-shrink-0">
            <button
              type="submit"
              name="automod_toggle"
              class="inline-flex items-center rounded-lg bg-primary-700 px-3 py-2 text-center text-sm font-medium text-white hover:bg-primary-800 focus:outline-none focus:ring-4 focus:ring-primary-300 dark:bg-primary-600 dark:hover:bg-primary-700 dark:focus:ring-primary-800">
              <%= tr("common:DASH.UPDATE_ALL") %>
            </button>
          </div>
        </div>
        <!-- END: Card Footer -->
      </form>
    </div>
  </div>
</section>
