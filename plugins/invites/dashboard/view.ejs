<!-- START: List Ranks -->
<section>
  <!-- START: Card Header -->
  <div class="items-center justify-between lg:flex">
    <div class="mb-4 lg:mb-0">
      <h3 class="mb-2 text-xl font-bold text-gray-900 dark:text-white"><%= tr("invites:DASH.RANKS_TITLE") %></h3>
      <span class="text-base font-normal text-gray-500 dark:text-gray-400"><%= tr("invites:DASH.RANKS_DESC") %></span>
    </div>
    <div class="items-center sm:flex">
      <div class="flex-shrink-0">
        <a data-modal-target="static-modal" data-modal-toggle="static-modal" class="cursor-pointer inline-flex items-center p-2 text-xs font-medium uppercase rounded-lg text-primary-700 sm:text-sm hover:bg-gray-100 dark:text-primary-500 dark:hover:bg-gray-700">
          <%= tr("invites:DASH.CREATE_MODAL_BTN") %>
          <i class="fa-solid fa-angle-right ml-1"></i>
        </a>
      </div>
    </div>
  </div>
    <!-- END: Card Header -->

  <!-- START: Card Body -->
  <div class="flex flex-col mt-6">
    <div class="overflow-x-auto rounded-lg">
      <div class="inline-block min-w-full align-middle">
        <div class="overflow-hidden shadow sm:rounded-lg">
          <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-600">
            <thead class="bg-gray-50 dark:bg-gray-700">
              <tr>
                <th scope="col" class="p-4 text-xs font-medium tracking-wider text-left text-gray-500 uppercase dark:text-white">
                  <%=tr("invites:DASH.ROLE_COL")%>
                </th>
                <th scope="col" class="p-4 text-xs font-medium tracking-wider text-left text-gray-500 uppercase dark:text-white">
                  <%=tr("invites:DASH.INVITES_COL")%>
                </th>
                <th scope="col" class="p-4 text-xs font-medium tracking-wider text-left text-gray-500 uppercase dark:text-white">
                  <%=tr("invites:DASH.ACTION_COL")%>
                </th>
              </tr>
            </thead>
            <tbody class="bg-white dark:bg-gray-800">
              <% ranks.forEach((rank) => { %>
              <form method="post">
                <tr class="border border-gray-200 rounded dark:border-gray-600">
                  <input type="hidden" name="rank_id" value="<%= rank.id %>"/>

                  <td class="p-4 text-sm font-normal text-gray-900 whitespace-nowrap dark:text-white">
                    <select name="role_id" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500">
                      <% guild.roles.cache.filter((r) => r != guild.roles.everyone && guild.members.me.roles.highest.position > r.position && !r.managed).map((r) => { %>
                        <option value="<%= r.id %>" <%= rank.id === r.id ? 'selected' : '' %>><%= r.name %></option>
                      <% }) %>
                    </select>
                  </td>
                  <td class="p-4 text-sm font-normal text-gray-500 whitespace-nowrap dark:text-gray-400">
                    <input
                      type="number"
                      name="invites"
                      min="0"
                      class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-gray-900 shadow-sm focus:border-primary-500 focus:ring-primary-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 dark:focus:border-primary-500 dark:focus:ring-primary-500 sm:text-sm"
                      value="<%= rank.invites %>"
                      required />
                  </td>
                  <td class="p-4 whitespace-nowrap">
                    <button type="submit" name="edit_rank">
                      <span class="bg-green-100 text-green-800 text-xs font-medium mr-2 px-2.5 py-0.5 rounded-md dark:bg-gray-700 dark:text-green-400 border border-green-100 dark:border-green-500">
                        <%=tr("invites:DASH.UPDATE_BTN")%>
                      </span>
                    </button>
                    <button type="submit" name="delete_rank">
                      <span class="bg-red-100 text-red-800 text-xs font-medium px-2.5 py-0.5 rounded-md dark:bg-gray-700 dark:text-red-400 border border-red-100 dark:border-red-500">
                        <%=tr("invites:DASH.DELETE_BTN")%>
                      </span>
                    </button>
                  </td>
                </tr>
              </form>

              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
  <!-- END: Card Body -->

</section>
<!-- END: List Giveaways -->

<!-- Main modal -->
<div id="static-modal" data-modal-backdrop="static" tabindex="-1" aria-hidden="true" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full">
    <div class="relative p-4 w-full max-w-2xl max-h-full">
      <form method="post">
        <!-- Modal content -->
        <div class="relative bg-white rounded-lg shadow dark:bg-gray-700">

          <!-- Modal header -->
          <div class="flex items-center justify-between p-4 md:p-5 border-b rounded-t dark:border-gray-600">
              <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
                <%= tr("invites:DASH.CREATE_RANK") %>
              </h3>
              <button type="button" class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center dark:hover:bg-gray-600 dark:hover:text-white" data-modal-hide="static-modal">
                  <i class="fa-solid fa-angle-right ml-1"></i>
                  <span class="sr-only">Close modal</span>
              </button>
          </div>

          <!-- Modal body -->
          <div class="p-4 md:p-5 space-y-4">
            <div class="mb-3">
              <div class="mb-2">
                <label for="role_id" class="text-sm font-semibold text-gray-900 dark:text-white"><%= tr("invites:DASH.ROLE_TITLE") %></label>
                <div class="text-sm font-normal text-gray-500 dark:text-gray-400">
                  <%= tr("invites:DASH.ROLE_DESC") %>
                </div>
              </div>
              <select aria-placeholder="<%= tr("invites:DASH.ROLE_PLACEHOLDER") %>" required name="role_id" id="role_id" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500">
                <% guild.roles.cache.filter((r) => r != guild.roles.everyone && guild.members.me.roles.highest.position > r.position && !r.managed).map((r) => { %>
                  <option value="<%= r.id %>"><%= r.name %></option>
                <% }) %>
              </select>
            </div>

            <div class="mb-3">
              <div class="mb-2">
                <label for="invites" class="text-sm font-semibold text-gray-900 dark:text-white"><%= tr("invites:DASH.INVITES_TITLE") %></label>
                <div class="text-sm font-normal text-gray-500 dark:text-gray-400">
                  <%= tr("invites:DASH.INVITES_DESC") %>
                </div>
              </div>
              <input
                type="number"
                name="invites"
                id="invites"
                min="0"
                class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-gray-900 shadow-sm focus:border-primary-500 focus:ring-primary-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 dark:focus:border-primary-500 dark:focus:ring-primary-500 sm:text-sm"
                required />
            </div>
          </div>

          <!-- Modal footer -->
          <div class="flex items-center mt-2 p-4 md:p-5 border-t border-gray-200 rounded-b dark:border-gray-600">
            <button name="add_rank" type="submit" class="text-white bg-primary-700 hover:bg-primary-800 focus:ring-4 focus:outline-none focus:ring-primary-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-primary-600 dark:hover:bg-primary-700 dark:focus:ring-primary-800"><%= tr("invites:DASH.CREATE_BTN") %></button>
          </div>
        </div>
      </form>
    </div>
</div>