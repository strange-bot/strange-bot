<section class="mb-6 px-4 pt-6">
  <div
    class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-gray-800 sm:p-6 2xl:col-span-2">
    <!-- START: Card Header -->
    <div class="mb-4 flex items-center justify-between border-b border-gray-200 pb-4 dark:border-gray-700">
      <h3 class="text-lg font-semibold text-gray-800 dark:text-white"><%= tr("giveaways:DASH.SERVER_DEFAULTS") %></h3>
    </div>
    <!-- END: Card Header -->

    <form method="post">
      <!-- START: Card Body -->
      <div class="mb-3">
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          <!-- START: Column 1 (Reaction Emoji) -->
          <div>
            <div class="mb-2">
              <label for="reaction" class="text-sm font-semibold text-gray-900 dark:text-white"
                ><%= tr("giveaways:DASH.REACTION_TITLE") %></label
              >
              <div class="text-sm font-normal text-gray-500 dark:text-gray-400">
                <%= tr("giveaways:DASH.REACTION_DESC") %>
              </div>
            </div>
            <input
              type="text"
              name="reaction"
              id="reaction"
              maxlength="2"
              class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-gray-900 shadow-sm focus:border-primary-500 focus:ring-primary-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 dark:focus:border-primary-500 dark:focus:ring-primary-500 sm:text-sm"
              value="<%= config.DEFAULT_EMOJI %>"
              required />
          </div>
          <!-- END: Column 1 -->

          <!-- START: Column 2 (Start Embed) -->
          <div>
            <div class="mb-2">
              <label for="start_embed_color" class="text-sm font-semibold text-gray-900 dark:text-white"
                ><%= tr("giveaways:DASH.START_EMBED_TITLE") %></label
              >
              <div class="text-sm font-normal text-gray-500 dark:text-gray-400">
                <%= tr("giveaways:DASH.START_EMBED_DESC") %>
              </div>
            </div>
            <input
              type="color"
              name="start_embed_color"
              id="start_embed_color"
              class="block h-10 w-full rounded-lg border border-gray-300 p-0.5 text-gray-900 shadow-sm focus:border-primary-500 focus:ring-primary-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 dark:focus:border-primary-500 dark:focus:ring-primary-500 sm:text-sm"
              value="<%= config.START_EMBED_COLOR %>"
              required />
          </div>
          <!-- END: Column 2 -->

          <!-- START: Column 3 (End Embed) -->
          <div>
            <div class="mb-2">
              <label for="end_embed_color" class="text-sm font-semibold text-gray-900 dark:text-white"
                ><%= tr("giveaways:DASH.END_EMBED_TITLE") %></label
              >
              <div class="text-sm font-normal text-gray-500 dark:text-gray-400">
                <%= tr("giveaways:DASH.END_EMBED_DESC") %>
              </div>
            </div>
            <input
              type="color"
              name="end_embed_color"
              id="end_embed_color"
              class="block h-10 w-full rounded-lg border border-gray-300 p-0.5 text-gray-900 shadow-sm focus:border-primary-500 focus:ring-primary-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 dark:focus:border-primary-500 dark:focus:ring-primary-500 sm:text-sm"
              value="<%= config.END_EMBED_COLOR %>"
              required />
          </div>
          <!-- END: Column 3 -->
        </div>
      </div>
      <!-- END: Card Body -->

      <!-- START: Card Footer -->
      <div class="mt-4 flex items-center justify-between border-t border-gray-200 pt-3 dark:border-gray-700 sm:pt-6">
        <div></div>
        <div class="flex-shrink-0">
          <button
            type="submit"
            name="config"
            class="inline-flex items-center rounded-lg bg-primary-700 px-3 py-2 text-center text-sm font-medium text-white hover:bg-primary-800 focus:outline-none focus:ring-4 focus:ring-primary-300 dark:bg-primary-600 dark:hover:bg-primary-700 dark:focus:ring-primary-800">
            <%= tr("common:DASH.UPDATE") %>
          </button>
        </div>
      </div>
      <!-- END: Card Footer -->
    </form>
  </div>
</section>
<!-- END: Basic Settings -->
