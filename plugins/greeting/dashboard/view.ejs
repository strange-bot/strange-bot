<section>
  <div class="grid gap-4 xl:grid-cols-2">
    <!-- START: Col 1 (Welcome Settings)-->
    <div class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-gray-800 sm:p-6 2xl:col-span-2">
      <!-- START: Card Header -->
      <div class="mb-4 flex items-center justify-between border-b-2 border-green-200 pb-4 dark:border-green-700">
        <h3 class="text-lg font-semibold text-gray-800 dark:text-white"><%= tr("greeting:DASH.WELCOME_TITLE") %></h3>
      </div>
      <!-- END: Card Header -->

      <form method="post">
        <!-- START: Card Body -->
        <div>
          <div class="mb-3">
            <div class="mb-2">
              <label for="welcome_channel" class="text-sm font-semibold text-gray-900 dark:text-white"><%= tr("greeting:DASH.CHANNEL_TITLE") %></label>
              <div class="text-sm font-normal text-gray-500 dark:text-gray-400">
                <%= tr("greeting:DASH.CHANNEL_DESC") %>
              </div>
            </div>
            <select id="welcome_channel" name="welcome_channel" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500">
              <option selected value disabled><%= tr("common:DASH.CHANNEL_SELECT") %></option>
              <% guild.channels.cache.filter((ch) => ch.type === 0).map((ch) => { %>
                <option value="<%= ch.id %>" <%= settings.welcome.channel === ch.id ? 'selected' : '' %>><%= ch.name %></option>
              <% }) %>
            </select>
          </div>

          <div class="mb-3">
            <div class="mb-2">
              <label for="welcome_content" class="text-sm font-semibold text-gray-900 dark:text-white"><%= tr("greeting:DASH.CONTENT_TITLE") %></label>
              <div class="text-sm font-normal text-gray-500 dark:text-gray-400">
                <%= tr("greeting:DASH.CONTENT_DESC") %>
              </div>
            </div>
            <textarea
              rows="3"
              maxlength="2000"
              id="welcome_content"
              name="welcome_content"
              class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500"
              placeholder="<%= tr("greeting:DASH.WELCOME_PLACEHOLDER") %>"
            ><%-settings.welcome.content?.replaceAll(/\\n/g, '&#10;')%></textarea>
          </div>

          <!-- START: Embed Options -->
          <div id="accordion-collapse-welcome" data-accordion="collapse" class="mt-5">
            <h3 id="accordion-collapse-heading-welcome">
              <button 
                type="button" 
                class="flex items-center justify-between w-full p-5 font-medium rtl:text-right text-gray-500 border border-b-0 border-gray-200 rounded-t-xl focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-800 dark:border-gray-700 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 gap-3" 
                data-accordion-target="#accordion-collapse-body-welcome" 
                aria-expanded="false" 
                aria-controls="accordion-collapse-body-welcome">
                <span><%= tr("greeting:DASH.EMBED_OPTIONS") %></span>
                <i class="fa-solid fa-angle-down"></i>
              </button>
            </h3>
            <div id="accordion-collapse-body-welcome" class="hidden" aria-labelledby="accordion-collapse-heading-welcome">
              <div class="p-5 border border-b-0 border-gray-200 dark:border-gray-700">

                <div class="mb-3">
                  <div class="mb-2">
                    <label for="welcome_embed_content" class="text-sm font-semibold text-gray-900 dark:text-white"><%= tr("greeting:DASH.EMBED_DESC_TITLE") %></label>
                    <div class="text-sm font-normal text-gray-500 dark:text-gray-400">
                      <%= tr("greeting:DASH.EMBED_DESC_DESC") %>
                    </div>
                  </div>
                  <textarea
                    rows="3"
                    maxlength="2000"
                    id="welcome_embed_content"
                    name="welcome_embed_content"
                    class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500"
                  ><%-settings.welcome.embed.description?.replaceAll(/\\n/g, '&#10;')%></textarea>
                </div>

                <div class="mb-3">
                  <div class="mb-2">
                    <label for="welcome_embed_footer" class="text-sm font-semibold text-gray-900 dark:text-white"><%= tr("greeting:DASH.EMBED_FOOTER_TITLE") %></label>
                    <div class="text-sm font-normal text-gray-500 dark:text-gray-400">
                      <%= tr("greeting:DASH.EMBED_FOOTER_DESC") %>
                    </div>
                  </div>
                  <input
                    type="string"
                    max="2000"
                    id="welcome_embed_footer"
                    name="welcome_embed_footer"
                    class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-gray-900 shadow-sm focus:border-primary-500 focus:ring-primary-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 dark:focus:border-primary-500 dark:focus:ring-primary-500 sm:text-sm"
                    value="<%= settings.welcome.embed.footer %>"
                    />
                </div>

                <div class="mb-3 flex items-center justify-between">
                  <div class="flex flex-grow flex-col">
                    <div class="mb-1 text-sm font-semibold text-gray-900 dark:text-white"><%= tr("greeting:DASH.EMBED_THUMB_TITLE") %></div>
                    <div class="text-sm font-normal text-gray-500 dark:text-gray-400">
                      <%= tr("greeting:DASH.EMBED_THUMB_DESC") %>
                    </div>
                  </div>
                  <label for="welcome_embed_thumbnail" class="relative flex cursor-pointer items-center">
                    <% if (settings.welcome.embed.thumbnail) { %>
                      <input type="checkbox" name="welcome_embed_thumbnail" id="welcome_embed_thumbnail" class="sr-only" checked />
                    <% } else { %>
                      <input type="checkbox" name="welcome_embed_thumbnail" id="welcome_embed_thumbnail" class="sr-only" />
                    <% } %>
                    <span class="toggle-bg h-6 w-11 rounded-full border border-gray-200 bg-gray-200 dark:border-gray-600 dark:bg-gray-700"></span>
                  </label>
                </div>

                <div class="mb-3">
                  <div class="mb-2">
                    <label for="welcome_embed_color" class="text-sm font-semibold text-gray-900 dark:text-white"><%= tr("automod/dash:LOG_EMBED_TITLE") %></label>
                    <div class="text-sm font-normal text-gray-500 dark:text-gray-400">
                      <%= tr("automod/dash:LOG_EMBED_DESC") %>
                    </div>
                  </div>
                  <div class="grid grid-cols-2 gap-4">
                    <input
                      type="color"
                      id="welcome_embed_color"
                      name="welcome_embed_color"
                      class="block w-full h-full min-h-10 rounded-lg border border-gray-300 p-0.5 text-gray-900 shadow-sm focus:border-primary-500 focus:ring-primary-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 dark:focus:border-primary-500 dark:focus:ring-primary-500 sm:text-sm"
                      value="<%= settings.welcome.embed.color %>"
                    />
                  </div>
                </div>

                <div class="mb-3">
                  <div class="mb-2">
                    <label for="welcome_embed_image" class="text-sm font-semibold text-gray-900 dark:text-white"><%= tr("greeting:DASH.EMBED_IMAGE_TITLE") %></label>
                    <div class="text-sm font-normal text-gray-500 dark:text-gray-400">
                      <%= tr("greeting:DASH.EMBED_IMAGE_DESC") %>
                    </div>
                  </div>
                  <input
                    type="url"
                    id="welcome_embed_image"
                    name="welcome_embed_image"
                    class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-gray-900 shadow-sm focus:border-primary-500 focus:ring-primary-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 dark:focus:border-primary-500 dark:focus:ring-primary-500 sm:text-sm"
                    value="<%= settings.welcome.embed.image %>"
                    />
                </div>

              </div>
            </div>
          </div>

        </div>
        <!-- END: Card Body -->

        <!-- START: Card Footer -->
        <div class="mt-4 flex items-center justify-between border-t border-gray-200 pt-3 dark:border-gray-700 sm:pt-6">
          <div>
            <% if (settings.welcome.enabled) { %>
              <button
                type="submit"
                name="welcome_disable"
                class="inline-flex items-center rounded-lg bg-red-700 px-3 py-2 text-center text-sm font-medium text-white hover:bg-red-800 focus:outline-none focus:ring-4 focus:ring-red-300 dark:bg-red-600 dark:hover:bg-red-700 dark:focus:ring-red-800">
                <%= tr("common:DASH.DISABLE") %>
              </button>
            <% } %>
          </div>
          <div class="flex-shrink-0">
            <% if (settings.welcome.enabled) { %>
              <button
                type="submit"
                name="welcome_update"
                class="inline-flex items-center rounded-lg bg-primary-700 px-3 py-2 text-center text-sm font-medium text-white hover:bg-primary-800 focus:outline-none focus:ring-4 focus:ring-primary-300 dark:bg-primary-600 dark:hover:bg-primary-700 dark:focus:ring-primary-800">
                <%= tr("common:DASH.UPDATE") %>
              </button>
            <% } else { %>
            <button
              type="submit"
              name="welcome_enable"
              class="inline-flex items-center rounded-lg bg-green-700 px-3 py-2 text-center text-sm font-medium text-white hover:bg-green-800 focus:outline-none focus:ring-4 focus:ring-primary-300 dark:bg-green-600 dark:hover:bg-green-700 dark:focus:ring-primary-800">
              <%= tr("common:DASH.ENABLE") %>
            </button>
            <% } %>
          </div>
        </div>
        <!-- END: Card Footer -->
      </form>
    </div>
    <!-- END: Col 1 -->

    <!-- START: Col 2 (Farewell Settings) -->
    <div class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-gray-800 sm:p-6 2xl:col-span-2">
