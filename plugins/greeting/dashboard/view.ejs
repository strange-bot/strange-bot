<%- contentFor("Autorole") %>
<section>
  <form method="post">
    <!-- START: Card Body -->
    <div class="mb-3">
      <div class="mb-2">
        <label for="role_id" class="text-sm font-semibold text-gray-900 dark:text-white"><%= tr("greeting:DASH.AUTOROLE_TITLE") %></label>
        <div class="text-sm font-normal text-gray-500 dark:text-gray-400">
          <%= tr("greeting:DASH.AUTOROLE_DESC") %>
        </div>
      </div>
      <select name="role_id" id="role_id" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500">
        <% if (!settings.role_id) { %>
          <option selected disabled><%= tr("common:DASH.ROLE_SELECT") %></option>
        <% } %>
        <% guild.roles.cache.filter((r) => r != guild.roles.everyone && guild.members.me.roles.highest.position > r.position && !r.managed).map((r) => { %>
          <option value="<%= r.id %>" <%= settings.role_id === r.id ? 'selected' : '' %>><%= r.name %></option>
        <% }) %>
      </select>
    </div>
    <!-- END: Card Body -->

    <!-- START: Card Footer -->
    <div class="mt-4 flex items-center justify-between border-t border-gray-200 pt-3 dark:border-gray-700 sm:pt-6">
      <div></div>
      <div class="flex-shrink-0">
        <button
          type="submit"
          name="autorole"
          class="inline-flex items-center rounded-lg bg-primary-700 px-3 py-2 text-center text-sm font-medium text-white hover:bg-primary-800 focus:outline-none focus:ring-4 focus:ring-primary-300 dark:bg-primary-600 dark:hover:bg-primary-700 dark:focus:ring-primary-800">
          <%= tr("common:DASH.UPDATE") %>
        </button>
      </div>
    </div>
    <!-- END: Card Footer -->
  </form>
</section>