              placeholder="<%= tr("greeting:DASH.FAREWELL_PLACEHOLDER") %>"
            ><%-settings.farewell.content?.replaceAll(/\\n/g, '&#10;')%></textarea>
          </div>

          <!-- START: Embed Options -->
          <div id="accordion-collapse-farewell" data-accordion="collapse" class="mt-5">
            <h3 id="accordion-collapse-heading-farewell">
              <button 
                type="button" 
                class="flex items-center justify-between w-full p-5 font-medium rtl:text-right text-gray-500 border border-b-0 border-gray-200 rounded-t-xl focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-800 dark:border-gray-700 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 gap-3" 
                data-accordion-target="#accordion-collapse-body-farewell" 
                aria-expanded="false" 
                aria-controls="accordion-collapse-body-farewell">
                <span><%= tr("greeting:DASH.EMBED_OPTIONS") %></span>
                <i class="fa-solid fa-angle-down"></i>
              </button>
            </h3>
            <div id="accordion-collapse-body-farewell" class="hidden" aria-labelledby="accordion-collapse-heading-farewell">
              <div class="p-5 border border-b-0 border-gray-200 dark:border-gray-700">

                <div class="mb-3">
                  <div class="mb-2">
                    <label for="farewell_embed_content" class="text-sm font-semibold text-gray-900 dark:text-white"><%= tr("greeting:DASH.EMBED_DESC_TITLE") %></label>
                    <div class="text-sm font-normal text-gray-500 dark:text-gray-400">
                      <%= tr("greeting:DASH.EMBED_DESC_DESC") %>
                    </div>
                  </div>
                  <textarea
                    rows="3"
                    maxlength="2000"
                    id="farewell_embed_content"
                    name="farewell_embed_content"
                    class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500"
                  ><%-settings.farewell.embed.description?.replaceAll(/\\n/g, '&#10;')%></textarea>
                </div>

                <div class="mb-3">
                  <div class="mb-2">
                    <label for="farewell_embed_footer" class="text-sm font-semibold text-gray-900 dark:text-white"><%= tr("greeting:DASH.EMBED_FOOTER_TITLE") %></label>
                    <div class="text-sm font-normal text-gray-500 dark:text-gray-400">
                      <%= tr("greeting:DASH.EMBED_FOOTER_DESC") %>
                    </div>
                  </div>
                  <input
                    type="string"
                    max="2000"
                    id="farewell_embed_footer"
                    name="farewell_embed_footer"
                    class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-gray-900 shadow-sm focus:border-primary-500 focus:ring-primary-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 dark:focus:border-primary-500 dark:focus:ring-primary-500 sm:text-sm"
                    value="<%= settings.farewell.embed.footer %>"
                    />
                </div>

                <div class="mb-3 flex items-center justify-between">
                  <div class="flex flex-grow flex-col">
                    <div class="mb-1 text-sm font-semibold text-gray-900 dark:text-white"><%= tr("greeting:DASH.EMBED_THUMB_TITLE") %></div>
                    <div class="text-sm font-normal text-gray-500 dark:text-gray-400">
                      <%= tr("greeting:DASH.EMBED_THUMB_DESC") %>
                    </div>
                  </div>
                  <label for="farewell_embed_thumbnail" class="relative flex cursor-pointer items-center">
                    <% if (settings.farewell.embed.thumbnail) { %>
                      <input type="checkbox" name="farewell_embed_thumbnail" id="farewell_embed_thumbnail" class="sr-only" checked />
                    <% } else { %>
                      <input type="checkbox" name="farewell_embed_thumbnail" id="farewell_embed_thumbnail" class="sr-only" />
                    <% } %>
                    <span class="toggle-bg h-6 w-11 rounded-full border border-gray-200 bg-gray-200 dark:border-gray-600 dark:bg-gray-700"></span>
