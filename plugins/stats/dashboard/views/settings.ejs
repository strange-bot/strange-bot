<form method="post">
  <!-- START: Card Body -->
  <div class="mb-3">

    <!-- START: Row 1 (XP Message) -->
    <div class="mb-3">
      <div class="mb-2">
        <label for="xp_message" class="text-sm font-semibold text-gray-900 dark:text-white"><%= tr("stats:DASH.LVL_MSG_TITLE") %></label>
        <div class="text-sm font-normal text-gray-500 dark:text-gray-400">
          <%= tr("stats:DASH.LVL_MSG_DESC") %>
        </div>
      </div>
      <input
        type="text"
        name="xp_message"
        id="xp_message"
        class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-gray-900 shadow-sm focus:border-primary-500 focus:ring-primary-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 dark:focus:border-primary-500 dark:focus:ring-primary-500 sm:text-sm"
        value="<%= settings.xp.message %>"
        required
      />
    </div>
    <!-- END: Row 1 -->

    <!-- START: Row 2 -->
    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-2">
      <!-- START: Column 1 (Channel) -->
      <div>
        <div class="mb-2">
          <label for="xp_channel" class="text-sm font-semibold text-gray-900 dark:text-white"><%= tr("stats:DASH.LVL_CH_TITLE") %></label>
          <div class="text-sm font-normal text-gray-500 dark:text-gray-400">
            <%= tr("stats:DASH.LVL_CH_DESC") %>
          </div>
        </div>
        <select name="xp_channel" id="xp_channel" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500">
          <option selected value><%= tr("common:DASH.CHANNEL_SELECT") %></option>
          <% guild.channels.cache.filter((ch) => ch.type === 0).map((ch) => { %>
            <option value="<%= ch.id %>" <%= settings.xp.channel === ch.id ? 'selected' : '' %>><%= ch.name %></option>
          <% }) %>
        </select>
      </div>
      <!-- END: Column 1 -->

      <!-- START: Column 2 (Cooldown) -->
      <div>
        <div class="mb-2">
          <label for="cooldown" class="text-sm font-semibold text-gray-900 dark:text-white"><%= tr("stats:DASH.COOLDOWN_TITLE") %></label>
          <div class="text-sm font-normal text-gray-500 dark:text-gray-400">
            <%= tr("stats:DASH.COOLDOWN_DESC") %>
          </div>
        </div>
        <input
          type="number"
          min="2"
          name="cooldown"
          id="cooldown"
          class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-gray-900 shadow-sm focus:border-primary-500 focus:ring-primary-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 dark:focus:border-primary-500 dark:focus:ring-primary-500 sm:text-sm"
          value="<%= settings.xp.cooldown %>"
          required
        />
      </div>
      <!-- END: Column 2 -->

    </div>
    <!-- END: Row 2 -->
    
  </div>
  <!-- END: Card Body -->

  <!-- START: Card Footer -->
  <div class="mt-4 flex items-center justify-between border-t border-gray-200 pt-3 dark:border-gray-700 sm:pt-6">
    <div></div>
    <div class="flex-shrink-0">
      <button
        type="submit"
        name="settings"
        class="inline-flex items-center rounded-lg bg-primary-700 px-3 py-2 text-center text-sm font-medium text-white hover:bg-primary-800 focus:outline-none focus:ring-4 focus:ring-primary-300 dark:bg-primary-600 dark:hover:bg-primary-700 dark:focus:ring-primary-800">
        <%= tr("common:DASH.UPDATE") %>
      </button>
    </div>
  </div>
  <!-- END: Card Footer -->
</form>