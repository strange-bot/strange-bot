<section>
  <!-- START: Card Header -->
  <div class="items-center justify-between lg:flex">
    <div class="mb-4 lg:mb-0">
      <span class="text-base font-normal text-gray-500 dark:text-gray-400"
        ><%= tr("youtube-alerts:CHANNELS_LIST") %></span
      >
    </div>
    <div class="items-center sm:flex">
      <div class="flex-shrink-0">
        <a
          data-modal-target="add-channel"
          data-modal-toggle="add-channel"
          class="inline-flex cursor-pointer items-center rounded-lg p-2 text-xs font-medium uppercase text-primary-700 hover:bg-gray-100 dark:text-primary-500 dark:hover:bg-gray-700 sm:text-sm">
          <%= tr("youtube-alerts:ADD_NEW_BTN") %>
          <i class="fa-solid fa-angle-right ml-1"></i>
        </a>
      </div>
    </div>
  </div>
  <!-- END: Card Header -->

  <!-- START: Card Body -->
  <div class="mt-6 flex flex-col">
    <div class="overflow-x-auto rounded-lg">
      <div class="inline-block min-w-full align-middle">
        <div class="overflow-hidden shadow sm:rounded-lg">
          <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-600">
            <thead class="bg-gray-50 dark:bg-gray-700">
              <tr>
                <th
                  scope="col"
                  class="p-4 text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-white">
                  <%=tr("youtube-alerts:CH_NAME")%>
                </th>
                <th
                  scope="col"
                  class="p-4 text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-white">
                  <%=tr("youtube-alerts:CH_ID")%>
                </th>
                <th
                  scope="col"
                  class="p-4 text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-white">
                  <%=tr("youtube-alerts:DISCORD_CH")%>
                </th>
                <th
                  scope="col"
                  class="p-4 text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-white">
                  <%=tr("youtube-alerts:ACTION")%>
                </th>
              </tr>
            </thead>
            <tbody class="bg-white dark:bg-gray-800">
              <% ytAlerts.forEach((alert, idx) => { %> <% if (idx % 2 === 0) { %>
              <tr class="bg-gray-50 dark:bg-gray-700">
                <% } else { %>
              </tr>
              <tr>
                <% } %>
                <td class="whitespace-nowrap p-4 text-sm font-normal text-gray-900 dark:text-white">
                  <%= alert.channelName %>
                </td>
                <td class="whitespace-nowrap p-4 text-sm font-normal text-gray-500 dark:text-gray-400">
                  <%= alert.id %>
                </td>
                <td class="whitespace-nowrap p-4 text-sm font-semibold text-gray-900 dark:text-white">
                  <%= "#" + guild.channels.cache.get(alert.notification.channel_id)?.name || "deleted" %>
                </td>
                <td class="whitespace-nowrap p-4">
                  <div class="flex items-center space-x-2">
                    <form method="post">
                      <input type="hidden" name="ch_id" value="<%= alert.id %>" />
                      <input type="hidden" name="discord_ch_id" value="<%= alert.notification.channel_id %>" />
                      <button name="test_channel" type="submit">
                        <span
                          class="mr-2 cursor-pointer rounded-md border border-green-100 bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-800 dark:border-green-500 dark:bg-gray-700 dark:text-green-400">
                          <%= tr("youtube-alerts:TEST_BTN") %>
                        </span>
                      </button>
                    </form>
                    <a data-modal-target="delete-modal-<%= idx %>" data-modal-toggle="delete-modal-<%= idx %>">
                      <span
                        class="cursor-pointer rounded-md border border-red-100 bg-red-100 px-2.5 py-0.5 text-xs font-medium text-red-800 dark:border-red-500 dark:bg-gray-700 dark:text-red-400"
                        ><%=tr("youtube-alerts:DELETE_BTN")%></span
                      >
                    </a>
                  </div>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
  <!-- END: Card Body -->
</section>

<div
  id="add-channel"
  tabindex="-1"
  aria-hidden="true"
  class="fixed left-0 right-0 top-0 z-50 hidden h-[calc(100%-1rem)] max-h-full w-full items-center justify-center overflow-y-auto overflow-x-hidden md:inset-0">
  <div class="relative max-h-full w-full max-w-2xl p-4">
    <form method="post">
      <!-- Modal content -->
      <div class="relative rounded-lg bg-white shadow dark:bg-gray-700">
        <!-- Modal header -->
        <div class="flex items-center justify-between rounded-t border-b p-4 dark:border-gray-600 md:p-5">
          <h4 class="text-xl font-semibold text-gray-900 dark:text-white"><%= tr("youtube-alerts:ADD_NEW_TITLE") %></h4>
          <button
            type="button"
            class="ms-auto inline-flex h-8 w-8 items-center justify-center rounded-lg bg-transparent text-sm text-gray-400 hover:bg-gray-200 hover:text-gray-900 dark:hover:bg-gray-600 dark:hover:text-white"
            data-modal-hide="add-channel">
            <i class="fa-solid fa-xmark h-4 w-4"></i>
            <span class="sr-only"><%=tr("youtube-alerts:CLOSE_BTN")%></span>
          </button>
        </div>

        <!-- Modal body -->
        <div class="space-y-4 p-4 md:p-5">
          <div class="mb-3">
            <div class="mb-2">
              <label for="ch_id" class="text-sm font-semibold text-gray-900 dark:text-white"
                ><%= tr("youtube-alerts:CH_ID") %>*</label
              >
              <div class="text-sm font-normal text-gray-500 dark:text-gray-400">
                <%= tr("youtube-alerts:CH_ID_DESC")%>
              </div>
            </div>
            <input
              type="string"
              name="ch_id"
              id="ch_id"
              class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-gray-900 shadow-sm focus:border-primary-500 focus:ring-primary-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 dark:focus:border-primary-500 dark:focus:ring-primary-500 sm:text-sm"
              required />
          </div>

          <div class="mb-3">
            <div>
              <div class="mb-2">
                <label for="discord_ch_id" class="text-sm font-semibold text-gray-900 dark:text-white"
                  ><%= tr("youtube-alerts:DISCORD_CH") %>*</label
                >
                <div class="text-sm font-normal text-gray-500 dark:text-gray-400">
                  <%= tr("youtube-alerts:DISCORD_CH_DESC") %>
                </div>
              </div>
              <select
                name="discord_ch_id"
                id="discord_ch_id"
                class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 dark:focus:border-blue-500 dark:focus:ring-blue-500">
                <option selected disabled><%= tr("youtube-alerts:ADD_DISCORD_CH_PLACEHOLDER") %></option>
                <% guild.channels.cache.filter((ch) => ch.type === 0).map((r) => { %>
                <option value="<%= r.id %>"><%= r.name %></option>
                <% }) %>
              </select>
            </div>
          </div>
        </div>

        <!-- Modal footer -->
        <div class="mt-2 flex items-center rounded-b border-t border-gray-200 p-4 dark:border-gray-600 md:p-5">
          <button
            name="add_channel"
            type="submit"
            class="rounded-lg bg-blue-700 px-5 py-2.5 text-center text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">
            <%= tr("youtube-alerts:CREATE_BTN") %>
          </button>
        </div>
      </div>
    </form>
  </div>
</div>

<% ytAlerts.forEach((alert, idx) => { %>
<div
  id="delete-modal-<%= idx %>"
  tabindex="-1"
  class="fixed left-0 right-0 top-0 z-50 hidden h-[calc(100%-1rem)] max-h-full w-full items-center justify-center overflow-y-auto overflow-x-hidden md:inset-0">
  <div class="relative max-h-full w-full max-w-md p-4">
    <div class="relative rounded-lg bg-white shadow dark:bg-gray-700">
      <button
        type="button"
        class="absolute end-2.5 top-3 ms-auto inline-flex h-8 w-8 items-center justify-center rounded-lg bg-transparent text-sm text-gray-400 hover:bg-gray-200 hover:text-gray-900 dark:hover:bg-gray-600 dark:hover:text-white"
        data-modal-hide="delete-modal-<%= idx %>">
        <i class="fa-solid fa-xmark h-4 w-4"></i>
        <span class="sr-only">Close modal</span>
      </button>
      <div class="p-4 text-center md:p-5">
        <i class="fa-regular fa-circle-exclamation mb-3 h-12 w-12 dark:text-gray-200"></i>
        <h3 class="mb-5 text-lg font-normal text-gray-500 dark:text-gray-400">
          <%= tr('youtube-alerts:DELETE_CONFIRMATION') %>
        </h3>
        <form method="post">
          <input type="hidden" name="ch_id" value="<%= alert.id %>" />
          <button
            data-modal-hide="delete-modal-<%= idx %>"
            name="remove_channel"
            type="submit"
            class="inline-flex items-center rounded-lg bg-blue-600 px-5 py-2.5 text-center text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300 dark:focus:ring-blue-800">
            <%= tr('youtube-alerts:DELETE_CONFIRM_YES') %>
          </button>
          <button
            data-modal-hide="delete-modal-<%= idx %>"
            type="button"
            class="ms-3 rounded-lg border border-gray-200 bg-white px-5 py-2.5 text-sm font-medium text-gray-900 hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:outline-none focus:ring-4 focus:ring-gray-100 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white dark:focus:ring-gray-700">
            <%= tr('youtube-alerts:DELETE_CONFIRM_NO') %>
          </button>
        </form>
      </div>
    </div>
  </div>
</div>
<% }) %>
