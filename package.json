{
    "name": "strange-bot",
    "version": "0.1.0-beta",
    "description": "Premium version of Discord JS Bot",
    "author": "Sai Teja M",
    "license": "AGPL-3.0-only",
    "engines": {
        "node": ">=18.0.0"
    },
    "private": true,
    "scripts": {
        "start": "NODE_ENV=production pnpm --parallel run start",
        "start:bot": "NODE_ENV=production pnpm --filter bot start",
        "start:dashboard": "NODE_ENV=production pnpm --filter dashboard start",
        "dev": "pnpm --parallel run dev",
        "dev:bot": "pnpm --filter bot dev",
        "dev:dashboard": "pnpm --filter dashboard dev",
        "format": "prettier --write 'apps/**/*.js' 'plugins/**/*.{js,json}'",
        "lint": "eslint --fix .",
        "validate": "node scripts/validate-env.js",
        "sync:config": "node scripts/sync-config.js",
        "sync:locales": "node scripts/sync-locales.js"
    },
    "homepage": "",
    "repository": {},
    "bugs": {},
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "eslint": "^9.0.0",
        "eslint-plugin-jsdoc": "^50.0.0",
        "pnpm": "^10.2.0",
        "prettier": "^3.2.5"
    },
    "keywords": [
        "discord",
        "discord.js",
        "discord-bot",
        "bot",
        "multipurpose",
        "multi-purpose-bot"
    ],
    "pnpm": {
        "onlyBuiltDependencies": [
            "bufferutil",
            "erlpack",
            "utf-8-validate",
            "zlib-sync"
        ]
    }
}
