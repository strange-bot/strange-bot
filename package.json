{
    "name": "strange-bot",
    "version": "1.0.0",
    "originVersion": "5.5.0",
    "description": "Premium version of Discord JS Bot",
    "main": "src/index.js",
    "author": "Sai Teja M",
    "license": "AGPL-3.0-only",
    "engines": {
        "node": ">=18.0.0"
    },
    "private": true,
    "workspaces": [
        "plugins/*"
    ],
    "scripts": {
        "start": "npm run build:webpack && node .",
        "git:pull": "git reset --hard && git clean -fd && git pull origin main",
        "git:modules:init": "git submodule update --init --recursive",
        "git:modules:update": "git submodule update --recursive --remote --force",
        "build:webpack": "webpack --mode=production",
        "build:css": "tailwindcss build -i src/dashboard/src/style.css -o src/dashboard/public/app.css",
        "dev": "npm-run-all --parallel dev:*",
        "dev:bot": "nodemon .",
        "dev:webpack": "webpack --mode=development --watch",
        "format": "prettier --write 'src/**/*.js' 'plugins/**/*.{js,json}'",
        "validate": "node scripts/validate-env.js"
    },
    "homepage": "",
    "repository": {},
    "bugs": {},
    "dependencies": {
        "connect-mongo": "^5.1.0",
        "cryptr": "^6.3.0",
        "discord-oauth2": "^2.12.1",
        "discord.js": "^14.15.2",
        "dotenv": "^16.4.5",
        "ejs": "^3.1.10",
        "express": "^4.19.2",
        "express-ejs-layouts": "^2.5.1",
        "express-session": "^1.18.0",
        "i18next": "^23.11.3",
        "isomorphic-dompurify": "^2.9.0",
        "mongoose": "^7.6.11",
        "strange-sdk": "github:strange-bot/strange-sdk"
    },
    "optionalDependencies": {
        "bufferutil": "^4.0.8",
        "erlpack": "^0.1.4",
        "utf-8-validate": "^6.0.3",
        "zlib-sync": "^0.1.9"
    },
    "devDependencies": {
        "@saiteja-madha/prettier-config": "^1.1.0",
        "apexcharts": "^3.49.0",
        "autoprefixer": "^10.4.19",
        "css-loader": "^6.11.0",
        "css-minimizer-webpack-plugin": "^5.0.1",
        "eslint": "^8.57.0",
        "eslint-plugin-jsdoc": "^46.10.1",
        "flowbite": "^2.1.1",
        "mini-css-extract-plugin": "^2.9.0",
        "node": "^18.20.2",
        "nodemon": "^3.0.3",
        "npm-run-all": "^4.1.5",
        "postcss": "^8.4.38",
        "postcss-loader": "^7.3.4",
        "prettier": "3.2.5",
        "style-loader": "^3.3.4",
        "tailwindcss": "^3.4.3",
        "tar": "^6.2.1",
        "webpack": "^5.91.0",
        "webpack-cli": "^5.1.4"
    },
    "keywords": [
        "discord",
        "discord.js",
        "discord-bot",
        "bot",
        "multipurpose",
        "multi-purpose-bot"
    ],
    "prettier": "@saiteja-madha/prettier-config",
    "eslintConfig": {
        "env": {
            "node": true,
            "commonjs": true,
            "es2021": true
        },
        "extends": "eslint:recommended",
        "parserOptions": {
            "ecmaVersion": 2022
        },
        "plugins": [
            "jsdoc"
        ],
        "rules": {
            "no-unused-vars": [
                "error",
                {
                    "args": "none"
                }
            ],
            "jsdoc/no-undefined-types": 1,
            "no-cond-assign": 0
        }
    }
}
