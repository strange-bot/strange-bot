{
    "name": "strange-bot",
    "version": "1.0.0",
    "description": "Premium version of Discord JS Bot",
    "types": "typings/index.d.ts",
    "main": "src/index.js",
    "author": "Sai Teja M",
    "license": "AGPL-3.0-only",
    "engines": {
        "node": ">=18.0.0"
    },
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*",
        "new-plugins/*"
    ],
    "scripts": {
        "start:bot": "pnpm --filter bot start",
        "start:dashboard": "pnpm --filter dashboard start",
        "git:pull": "git reset --hard && git fetch && git pull origin main",
        "git:modules:update": "git submodule update --init --recursive",
        "format": "prettier --write 'src/**/*.js' 'plugins/**/*.{js,json}'",
        "validate": "node scripts/validate-env.js",
        "sync:config": "node scripts/sync-config.js",
        "sync:locales": "node scripts/sync-locales.js"
    },
    "homepage": "",
    "repository": {},
    "bugs": {},
    "devDependencies": {
        "eslint": "^8.57.1",
        "eslint-plugin-jsdoc": "^46.10.1",
        "prettier": "3.2.5"
    },
    "keywords": [
        "discord",
        "discord.js",
        "discord-bot",
        "bot",
        "multipurpose",
        "multi-purpose-bot"
    ],
    "eslintConfig": {
        "env": {
            "node": true,
            "commonjs": true,
            "es2021": true
        },
        "extends": "eslint:recommended",
        "parserOptions": {
            "ecmaVersion": 2022
        },
        "plugins": [
            "jsdoc"
        ],
        "rules": {
            "no-unused-vars": [
                "error",
                {
                    "args": "none"
                }
            ],
            "jsdoc/no-undefined-types": 1,
            "no-cond-assign": 0
        }
    }
}
