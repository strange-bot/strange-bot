<div
  class="container mx-auto px-4 py-6 dark:bg-gray-900 lg:px-6"
  x-data="{
  plugins: [],
  loading: true,
  selectedPlugin: null,
  loadingPlugins: new Set(),
  togglingPlugins: new Set(),
  updatingPlugins: new Set(),
  isLoading(pluginName) {
    return this.loadingPlugins.has(pluginName);
  },
  isToggling(pluginName) {
    return this.togglingPlugins.has(pluginName);
  },
  isUpdating(pluginName) {
    return this.updatingPlugins.has(pluginName);
  },
  async init() {
    try {
      const response = await fetch('/admin/plugins');
      this.plugins = await response.json();
    } catch (error) {
      console.error('Failed to load plugins:', error);
    } finally {
      this.loading = false;
    }
  },
  async togglePlugin(plugin) {
    if (this.isToggling(plugin.name)) return;
    this.togglingPlugins.add(plugin.name);
    try {
      const action = plugin.enabled ? 'disable' : 'enable';
      const response = await fetch('/admin/plugins', {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ pluginName: plugin.name, action: action })
      });
      if (response.ok) {
        plugin.enabled = !plugin.enabled;
        Alpine.store('toast').show(`Plugin ${plugin.name} ${action}d successfully`, 'success');
      } else {
        throw new Error(`Failed to ${action} plugin`);
      }
    } catch (error) {
      Alpine.store('toast').show(`Failed to ${plugin.enabled ? 'disable' : 'enable'} plugin`, 'error');
    } finally {
      this.togglingPlugins.delete(plugin.name);
    }
  },
  async installPlugin(plugin) {
    if (this.isLoading(plugin.name)) return;
    this.loadingPlugins.add(plugin.name);
    try {
      const response = await fetch('/admin/plugins', {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ pluginName: plugin.name, action: 'install' })
      });
      if (response.ok) {
        plugin.installed = true;
        Alpine.store('toast').show(`Plugin ${plugin.name} installed successfully`, 'success');
      }
    } catch (error) {
      Alpine.store('toast').show('Failed to install plugin', 'error');
    } finally {
      this.loadingPlugins.delete(plugin.name);
    }
  },
  async uninstallPlugin(plugin) {
    if (this.isLoading(plugin.name)) return;
    this.loadingPlugins.add(plugin.name);
    try {
      const response = await fetch('/admin/plugins', {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ pluginName: plugin.name, action: 'uninstall' })
      });
      if (response.ok) {
        plugin.installed = false;
        plugin.enabled = false;
        Alpine.store('toast').show(`Plugin ${plugin.name} uninstalled successfully`, 'success');
      }
    } catch (error) {
      Alpine.store('toast').show('Failed to uninstall plugin', 'error');
    } finally {
      this.loadingPlugins.delete(plugin.name);
    }
  },
  async updatePlugin(plugin) {
    if (this.isUpdating(plugin.name)) return;
    this.updatingPlugins.add(plugin.name);
    try {
      const response = await fetch('/admin/plugins', {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ pluginName: plugin.name, action: 'update' })
      });
      if (response.ok) {
        plugin.currentVersion = plugin.version;
        plugin.hasUpdate = false;
        Alpine.store('toast').show(`Plugin ${plugin.name} updated successfully`, 'success');
      }
    } catch (error) {
      Alpine.store('toast').show('Failed to update plugin', 'error');
    } finally {
      this.updatingPlugins.delete(plugin.name);
    }
  },
  searchTerm: '',
  get filteredPlugins() {
    if (!this.searchTerm) return this.plugins;
    const term = this.searchTerm.toLowerCase();
    return this.plugins.filter(plugin => 
      plugin.name.toLowerCase().includes(term) || 
      (plugin.description && plugin.description.toLowerCase().includes(term)) ||
      (plugin.author && plugin.author.toLowerCase().includes(term))
    );
  }
}">
  <div class="mb-6 flex items-center justify-between">
    <h1 class="text-2xl font-bold dark:text-white"><%=tr("ADMIN_PAGE.PLUGINS")%></h1>
    <span class="text-sm text-gray-500 dark:text-gray-400" x-text="'Total plugins: ' + plugins.length"></span>
  </div>

  <!-- Search Bar -->
  <div class="mb-4">
    <div class="relative">
      <input
        type="text"
        x-model="searchTerm"
        placeholder="Search plugins..."
        class="w-full pl-10 pr-4 py-2 border rounded-lg dark:bg-gray-800 dark:border-gray-700 dark:text-gray-300 focus:outline-none focus:border-primary-500 dark:focus:border-primary-500" />
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <svg class="h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
          <path
            fill-rule="evenodd"
            d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z"
            clip-rule="evenodd" />
        </svg>
      </div>
    </div>
  </div>

  <!-- Loading State -->
  <div x-show="loading" class="text-center py-8">
    <div
      class="animate-spin inline-block w-8 h-8 border-4 border-blue-600 dark:border-blue-500 border-t-transparent rounded-full"></div>
    <p class="mt-2 dark:text-gray-300"><%=tr("ADMIN_PAGE.LOADING")%></p>
  </div>

  <!-- Plugins Grid -->
  <div x-show="!loading" class="grid gap-6" style="grid-template-columns: repeat(auto-fit, minmax(250px, 1fr))">
    <template x-for="plugin in filteredPlugins" :key="plugin.name">
      <div
        class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-md hover:shadow-lg transition-shadow min-w-[240px] p-6 flex flex-col justify-between h-full">
        <div>
          <div class="flex items-start justify-between mb-2">
            <h3 class="text-lg font-bold text-gray-900 dark:text-white tracking-tight">
              <span x-text="plugin.name"></span>
            </h3>
            <span
              x-show="plugin.installed"
              :class="[
                plugin.enabled ? 'bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-300' : 'bg-gray-200 text-gray-600 dark:bg-gray-700 dark:text-gray-300',
                isToggling(plugin.name) ? 'opacity-60 pointer-events-none' : 'cursor-pointer hover:opacity-80 transition'
              ]"
              class="px-2 py-0.5 rounded-full text-xs font-semibold ml-2 border border-transparent flex items-center min-w-[70px] justify-center"
              @click="!isToggling(plugin.name) && togglePlugin(plugin)">
              <i class="fa-solid fa-spinner fa-spin mr-1" x-show="isToggling(plugin.name)"></i>
              <span x-text="plugin.enabled ? 'Enabled' : 'Disabled'"></span>
            </span>
          </div>
          <div class="flex items-center justify-between text-sm text-gray-500 dark:text-gray-400 mb-1">
            <span> by <span x-text="plugin.author || 'Unknown'"></span> </span>
            <span class="font-mono text-xs" x-text="'v' + plugin.currentVersion"></span>
          </div>
          <p class="text-sm text-gray-600 dark:text-gray-300 mb-3" x-text="plugin.description"></p>
          <template x-if="plugin.repository">
            <a
              :href="plugin.repository + (plugin.repositoryPath ? '/tree/main/' + plugin.repositoryPath : '')"
              target="_blank"
              class="inline-flex items-center gap-1 text-primary-600 dark:text-primary-400 font-medium hover:underline text-sm">
              <i class="fa-brands fa-github"></i> View Source
            </a>
          </template>
        </div>
        <div class="border-t border-gray-200 dark:border-gray-700 mt-4 pt-4 flex justify-end">
          <button
            x-show="plugin.name !== 'core'"
            @click="plugin.installed ? uninstallPlugin(plugin) : installPlugin(plugin)"
            :disabled="isLoading(plugin.name)"
            :class="plugin.installed ? 'bg-red-600 hover:bg-red-700' : 'bg-primary-600 hover:bg-primary-700'"
            class="px-3 py-1.5 rounded-md text-xs font-semibold text-white disabled:opacity-50 disabled:cursor-not-allowed shadow-sm transition-colors min-w-[80px]">
            <span x-text="plugin.installed ? 'Uninstall' : 'Install'"></span>
          </button>
        </div>
      </div>
    </template>
  </div>

  <!-- Empty State -->
  <div x-show="!loading && filteredPlugins.length === 0" class="text-center py-8">
    <p class="text-gray-500 dark:text-gray-400"><%=tr("ADMIN_PAGE.NO_MATCH")%></p>
  </div>
</div>
