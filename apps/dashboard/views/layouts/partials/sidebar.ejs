<aside
  id="sidebar"
  class="fixed left-0 top-0 z-20 flex hidden h-full w-64 flex-shrink-0 flex-col pt-16 font-normal transition-width duration-75 lg:flex overflow-y-auto"
  aria-label="Sidebar">
  <div
    class="relative flex min-h-0 flex-1 flex-col border-r border-gray-200 bg-white pt-0 dark:border-gray-700 dark:bg-gray-800">
    <div class="flex flex-1 flex-col overflow-y-auto pb-4 pt-5 mb-[50px]">
      <div class="flex-1 space-y-1 divide-y divide-gray-200 bg-white px-3 dark:divide-gray-700 dark:bg-gray-800">
        <ul class="space-y-2 pb-2">
          <li>
            <a
              href="/dashboard"
              class="group flex items-center rounded-lg p-2 text-base text-gray-900 hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-700 <% if (slug === "selector") { %>bg-gray-100 dark:bg-gray-700<% }%>">
              <i class="fa-solid fa-chart-pie text-gray-500 group-hover:text-gray-900 dark:text-gray-400 dark:group-hover:text-white"></i>
              <span class="text-sm md:text-base ml-3" sidebar-toggle-item><%= tr('SIDEBAR.SELECTOR') %></span>
            </a>
          </li>

          <% if (locals.guild) { %>
          <li>
            <a
              href="/dashboard/<%=guild.id%>"
              class="group flex items-center rounded-lg p-2 text-base text-gray-900 hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-700 <% if (slug === "home") { %>bg-gray-100 dark:bg-gray-700<% }%>">
              <i class="fa-solid fa-house text-gray-500 group-hover:text-gray-900 dark:text-gray-400 dark:group-hover:text-white"></i>
              <span class="ml-3 text-sm md:text-base" sidebar-toggle-item><%= tr('SIDEBAR.HOME') %></span>
            </a>
          </li>
          <% } %>

          <% if (locals.guild && locals.plugins) { %>

          <li>
            <button
              type="button"
              class="group flex w-full items-center rounded-lg p-2 text-base text-gray-900 transition duration-75 hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-700"
              aria-controls="dropdown-plugins"
              data-collapse-toggle="dropdown-plugins">
              <i class="fa-solid fa-puzzle-piece text-gray-500 group-hover:text-gray-900 dark:text-gray-400 dark:group-hover:text-white text-xl"></i>
              <span class="ml-3 text-sm md:text-base flex-1 whitespace-nowrap text-left" sidebar-toggle-item><%= tr('SIDEBAR.PLUGINS') %></span>
              <i class="fa-solid fa-angle-down"></i>
            </button>
            <ul id="dropdown-plugins" class="space-y-2 py-2 <% if (!slug.includes('plugins')) { %>hidden<% }%>">
              <% for (let i = 0; i < plugins.length; i++) { %> 
                <% let urlName = plugins[i].name %> 
                <% let name =plugins[i].name.charAt(0).toUpperCase() + plugins[i].name.slice(1).toLowerCase() %>
              <li <% if (slug.includes(plugins[i].name)) { %>id="aside-active-item"<% }%>>
                <a
                  href="/dashboard/<%=guild.id%>/<%=urlName%>"
                  class="text-sm md:text-base group flex items-center rounded-lg p-2 pl-11 text-gray-900 transition duration-75 hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-700 <% if (slug.includes(plugins[i].name)) { %>bg-gray-100 dark:bg-gray-700<% }%>"
                  ><%=name%></a
                >
              </li>
              <% } %>
            </ul>
          </li>

          <% } %>
        </ul>
      </div>
    </div>
    <div
      class="absolute bottom-0 left-0 hidden w-full justify-center space-x-4 bg-white p-4 dark:bg-gray-800 lg:flex"
      sidebar-bottom-menu>
      <a
        href="#"
        data-tooltip-target="tooltip-documentation"
        class="inline-flex cursor-pointer justify-center rounded p-2 text-gray-500 hover:bg-gray-100 hover:text-gray-900 dark:hover:bg-gray-700 dark:hover:text-white">
        <i class="fa-solid fa-book h-5 w-5 flex-shrink-0 text-gray-500 transition duration-75 group-hover:text-gray-900 dark:text-gray-400 dark:group-hover:text-white"></i>
      </a>
      <div
        id="tooltip-documentation"
        role="tooltip"
        class="tooltip invisible absolute z-10 inline-block rounded-lg bg-gray-900 px-3 py-2 text-sm font-medium text-white opacity-0 shadow-sm transition-opacity duration-300"
        sidebar-bottom-tooltip>
        <%= tr('SIDEBAR.TIP_DOCUMENTATION') %>
        <div class="tooltip-arrow" data-popper-arrow></div>
      </div>
      <a
        href="https://github.com/saiteja-madha/discord-js-bot"
        data-tooltip-target="tooltip-settings"
        class="inline-flex cursor-pointer justify-center rounded p-2 text-gray-500 hover:bg-gray-100 hover:text-gray-900 dark:hover:bg-gray-700 dark:hover:text-white">
        <i class="fa-brands fa-github h-5 w-5 flex-shrink-0 text-gray-500 transition duration-75 group-hover:text-gray-900 dark:text-gray-400 dark:group-hover:text-white"></i>
      </a>
      <div
        id="tooltip-settings"
        role="tooltip"
        class="tooltip invisible absolute z-10 inline-block rounded-lg bg-gray-900 px-3 py-2 text-sm font-medium text-white opacity-0 shadow-sm transition-opacity duration-300 dark:bg-gray-700">
        <%= tr('SIDEBAR.TIP_GITHUB') %>
        <div class="tooltip-arrow" data-popper-arrow></div>
      </div>
      <button
        type="button"
        data-dropdown-toggle="language-dropdown"
