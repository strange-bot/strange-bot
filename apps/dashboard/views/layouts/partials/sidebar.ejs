<aside
  id="sidebar"
  class="transition-width fixed left-0 top-0 z-20 flex hidden h-full w-80 flex-shrink-0 flex-col overflow-y-auto pt-16 font-normal duration-75 lg:flex"
  aria-label="Sidebar">
  <div class="border-border bg-bg-panel relative flex min-h-0 flex-1 flex-col border-r pt-0">
    <div class="mb-[50px] flex flex-1 flex-col overflow-y-auto pb-4 pt-5">
      <!-- Group 1 -->
      <div class="mb-6 px-4">
        <% if (!locals.guild) { %>
        <a
          href="/dashboard"
          class="<%= slug === 'selector' ? 'bg-bg-interactive' : '' %> text-text hover:bg-bg-surface group flex items-center rounded-lg p-3 text-base font-medium transition">
          <i class="fa-solid fa-server text-text-muted group-hover:text-text text-xl"></i>
          <span class="ml-3" sidebar-toggle-item><%= tr('SIDEBAR.SERVERS') %></span>
        </a>
        <% } else { %>
        <button
          id="dropdownGuildButton"
          data-dropdown-toggle="dropdownGuild"
          data-dropdown-placement="bottom"
          class="text-text hover:bg-bg-surface border-border group flex w-full items-center rounded-lg border p-3 text-base font-medium transition"
          type="button">
          <img class="h-7 w-7 rounded-full" src="<%= guild.iconURL %>" alt="<%= guild.name %> icon" />
          <span class="ml-3 flex-1 whitespace-nowrap text-left" sidebar-toggle-item><%= guild.name %></span>
          <i class="fa-solid fa-angle-down"></i>
        </button>
        <!-- Dropdown menu -->
        <div
          id="dropdownGuild"
          class="bg-bg-panel border-border z-50 hidden w-[18rem] overflow-hidden rounded-lg border shadow-lg">
          <ul class="max-h-60 overflow-y-auto py-2" aria-labelledby="dropdownGuildButton">
            <% guilds.filter(g => g.admin && !g.settingsUrl.includes('discord.com')).forEach(function(g) { %>
            <li class="mb-1 px-2">
              <a
                href="<%= g.settingsUrl %>"
                class="<%= guild && g.id === guild.id ? 'bg-bg-interactive' : 'hover:bg-bg-interactive' %> text-text flex items-center rounded-lg p-3 font-medium transition">
                <div class="ring-primary-light relative me-3 rounded-full ring-2">
                  <img
                    class="border-border h-7 w-7 rounded-full border shadow-sm"
                    src="<%= g.iconURL %>"
                    alt="<%= g.name %> icon" />
                </div>
                <span class="truncate"><%= g.name %></span>
              </a>
            </li>
            <% }); %>
            <!-- Divider -->
            <li class="px-2">
              <hr class="border-border my-2 border-t" />
            </li>
            <!-- Add New Server Option -->
            <li class="px-2">
              <a
                href="/dashboard/"
                class="hover:bg-bg-interactive text-text flex items-center rounded-lg p-3 font-medium transition">
                <i class="fa-solid fa-circle-plus text-text-muted mr-3 text-xl"></i>
                <span class="truncate">Add new server</span>
              </a>
            </li>
          </ul>
        </div>
        <% } %>
      </div>

      <!-- Group 2 -->
      <div class="mb-6 px-4">
        <ul>
          <% if (locals.guild) { %>
          <li class="mb-1">
            <a
              href="/dashboard/<%=guild.id%>"
              class="<%= slug === 'home' ? 'bg-bg-interactive' : 'hover:bg-bg-surface' %> text-text group flex items-center rounded-lg p-3 text-base font-medium transition">
              <i class="fa-solid fa-house-chimney-window text-text-muted mr-3 text-xl"></i>
              <span>Dashboard</span>
            </a>
          </li>
          <% } %>
        </ul>
      </div>

      <!-- Group 3 -->
      <div class="px-4">
        <ul class="space-y-2 pb-2">
          <% if (locals.guild && locals.enabledPlugins) { %>
          <!-- Section Header as Collapse Toggle -->
          <li class="mb-1 mt-3 px-2">
            <button
              type="button"
              class="text-text flex w-full items-center text-xs font-bold uppercase tracking-widest focus:outline-none"
              aria-controls="dropdown-plugins"
              data-collapse-toggle="dropdown-plugins">
              <span class="flex-1 text-left">Plugins</span>
              <i class="fa-solid fa-angle-down ml-2"></i>
            </button>
          </li>
          <li>
            <!-- Plugins List -->
            <ul id="dropdown-plugins" class="<%= slug.includes('plugins') ? '' : 'hidden' %> space-y-1 py-1">
              <% enabledPlugins.forEach(function(plugin) { if (plugin.ownerOnly) return; let urlName = plugin.name; let
              name = plugin.name.charAt(0).toUpperCase() + plugin.name.slice(1).toLowerCase(); let isActive =
              slug.includes(plugin.name); %>
              <li>
                <% if (isActive) { %>
                <a
                  id="aside-active-item"
                  href="/dashboard/<%=guild.id%>/<%=urlName%>"
                  class="text-text bg-bg-interactive border-primary group flex items-center rounded-lg border-l-4 p-3 pl-10 text-base font-medium transition">
                  <i class="<%= plugin.icon %> text-text-muted mr-3 text-xl"></i>
                  <%=name%>
                </a>
                <% } else { %>
                <a
                  href="/dashboard/<%=guild.id%>/<%=urlName%>"
                  class="text-text hover:bg-bg-surface group flex items-center rounded-lg p-3 pl-10 text-base font-medium transition">
                  <i class="<%= plugin.icon %> text-text-muted mr-3 text-xl"></i>
                  <%=name%>
                </a>
                <% } %>
              </li>
              <% }); %>
            </ul>
          </li>
          <% } %>
        </ul>
      </div>
    </div>
    <%- include('./sidebar-bottom.ejs') %>
  </div>
</aside>

<div class="fixed inset-0 z-10 hidden bg-gray-900/50 dark:bg-gray-900/90" id="sidebarBackdrop"></div>
