<div class="pb-6">
  <nav class="border-border bg-bg-panel text-text-muted flex rounded-lg border px-5 py-3" aria-label="Breadcrumb">
    <ol class="inline-flex items-center space-x-1 md:space-x-2 rtl:space-x-reverse">
      <li class="inline-flex items-center">
        <a
          href="/admin"
          class="hover:text-primary-600 text-text-muted hover:text-text inline-flex items-center text-sm font-medium">
          <svg
            class="me-2.5 h-4 w-4"
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            fill="currentColor"
            viewBox="0 0 24 24">
            <path
              fill-rule="evenodd"
              d="M11.293 3.293a1 1 0 0 1 1.414 0l6 6 2 2a1 1 0 0 1-1.414 1.414L19 12.414V19a2 2 0 0 1-2 2h-3a1 1 0 0 1-1-1v-3h-2v3a1 1 0 0 1-1 1H7a2 2 0 0 1-2-2v-6.586l-.293.293a1 1 0 0 1-1.414-1.414l2-2 6-6Z"
              clip-rule="evenodd" />
          </svg>
          <%= tr('BREADCRUMB.ADMIN') %>
        </a>
      </li>

      <% if (locals.plugin) { %>
      <li aria-current="page">
        <div class="flex items-center">
          <svg
            class="text-text-muted h-4 w-4"
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            fill="none"
            viewBox="0 0 24 24">
            <path
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="m9 5 7 7-7 7" />
          </svg>
          <% const name = plugin.name.charAt(0).toUpperCase() + plugin.name.slice(1); %>
          <span class="text-text-muted ms-1 text-sm font-medium md:ms-2"><%=name%></span>
        </div>
      </li>
      <% } %>
    </ol>
  </nav>
</div>
