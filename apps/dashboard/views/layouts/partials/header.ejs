<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content="<%= locals.description || 'A feature rich multipurpose discord bot' %>" />
<meta name="author" content="<%= coreConfig['DASHBOARD']['LOGO_NAME'] %>" />
<meta name="generator" content="<%= coreConfig['DASHBOARD']['LOGO_NAME'] %>" />
<meta http-equiv="Content-Language" content="en" />

<% if (locals.title) { %>
<title><%= locals.title %></title>
<% } else { %>
<title>Dashboard</title>
<% } %>

<link rel="canonical" href="<%= locals.permalink || '' %>" />

<%- include('stylesheet.ejs') %> <%- include('favicons.ejs') %> <%- include('analytics.ejs') %>
