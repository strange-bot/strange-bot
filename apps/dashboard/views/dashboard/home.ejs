<section class="container mx-auto px-4 py-8 text-center lg:px-6 lg:py-8 dark:bg-gray-900">
  <div class="grid gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-4">
    <!-- Card -->
    <div class="flex flex-col rounded-xl border bg-white shadow-sm dark:border-gray-700 dark:bg-gray-800">
      <div class="p-4 md:p-5">
        <div class="flex items-center gap-x-2">
          <p class="text-xs uppercase tracking-wide text-gray-500 dark:text-neutral-200"><%= tr('HOME.MEMBERS') %></p>
        </div>

        <div class="mt-1 flex items-center gap-x-2">
          <h3 class="text-xl font-medium text-gray-800 sm:text-2xl dark:text-neutral-200"><%= guild.members %></h3>
        </div>
      </div>
    </div>

    <div class="flex flex-col rounded-xl border bg-white shadow-sm dark:border-gray-700 dark:bg-gray-800">
      <div class="p-4 md:p-5">
        <div class="flex items-center gap-x-2">
          <p class="text-xs uppercase tracking-wide text-gray-500 dark:text-neutral-200"><%= tr('HOME.ROLES') %></p>
        </div>

        <div class="mt-1 flex items-center gap-x-2">
          <h3 class="text-xl font-medium text-gray-800 sm:text-2xl dark:text-neutral-200"><%= guild.roles %></h3>
        </div>
      </div>
    </div>

    <div class="flex flex-col rounded-xl border bg-white shadow-sm dark:border-gray-700 dark:bg-gray-800">
      <div class="p-4 md:p-5">
        <div class="flex items-center gap-x-2">
          <p class="text-xs uppercase tracking-wide text-gray-500 dark:text-neutral-200">
            <%= tr('HOME.TXT_CHANNELS') %>
          </p>
        </div>

        <div class="mt-1 flex items-center gap-x-2">
          <h3 class="text-xl font-medium text-gray-800 sm:text-2xl dark:text-neutral-200">
            <%= guild.channels.text %>
          </h3>
        </div>
      </div>
    </div>

    <div class="flex flex-col rounded-xl border bg-white shadow-sm dark:border-gray-700 dark:bg-gray-800">
      <div class="p-4 md:p-5">
        <div class="flex items-center gap-x-2">
          <p class="text-xs uppercase tracking-wide text-gray-500 dark:text-neutral-200">
            <%= tr('HOME.VC_CHANNELS') %>
          </p>
        </div>

        <div class="mt-1 flex items-center gap-x-2">
          <h3 class="text-xl font-medium text-gray-800 sm:text-2xl dark:text-neutral-200">
            <%= guild.channels.voice %>
          </h3>
        </div>
      </div>
    </div>
    <!-- End Card -->
  </div>
</section>

<section
  class="container mx-auto px-4 py-8 lg:px-6 lg:py-8"
  x-data="{
  view: localStorage.getItem('home-plugin-view') || 'grid',
  setView(v) {
    this.view = v;
    localStorage.setItem('home-plugin-view', v);
  }
}">
  <div class="mb-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white"><%= tr('HOME.SUB_PLUGINS') %></h2>
      <div class="flex gap-2">
        <button
          type="button"
          @click="setView('grid')"
          :class="view === 'grid' ? 'bg-primary-600 text-white dark:bg-primary-500 dark:text-white border border-primary-600 dark:border-primary-500 shadow' : 'bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-200 border border-gray-200 dark:border-gray-600'"
          class="btn flex items-center rounded px-3 py-1 text-sm font-medium">
          <i class="fa-solid fa-th mr-1"></i> Grid
        </button>
        <button
          type="button"
          @click="setView('list')"
          :class="view === 'list' ? 'bg-primary-600 text-white dark:bg-primary-500 dark:text-white border border-primary-600 dark:border-primary-500 shadow' : 'bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-200 border border-gray-200 dark:border-gray-600'"
          class="btn flex items-center rounded px-3 py-1 text-sm font-medium">
          <i class="fa-solid fa-list mr-1"></i> List
        </button>
      </div>
    </div>
  </div>

  <!-- Grid/List for plugin information -->
  <div x-show="view === 'grid'" x-cloak :class="'grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4'">
    <% plugins.filter(p => !p.ownerOnly).forEach(plugin => { %>
    <div
      class="plugin-card flex flex-row items-center gap-6 rounded-xl border bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-gray-800">
      <div class="flex h-16 w-16 flex-shrink-0 items-center justify-center">
        <i class="<%= plugin.icon %> text-primary-600 dark:text-primary-400 h-10 w-10"></i>
      </div>
      <div class="flex flex-1 flex-col justify-center">
        <h3 class="mb-1 text-base font-bold text-gray-900 dark:text-white">
          <%= plugin.name[0].toUpperCase() + plugin.name.slice(1) %>
        </h3>
        <p class="mb-1 text-xs text-gray-600 dark:text-gray-300"><%= plugin.description %></p>
        <div class="mb-2 flex gap-2">
          <span class="text-xs text-gray-500 dark:text-gray-400"
            ><%= tr('HOME.LABEL_PREFIX') %>: <%= pluginCmds[plugin.name].prefixCount %></span
          >
          <span class="text-xs text-gray-500 dark:text-gray-400"
            ><%= tr('HOME.LABEL_SLASH') %>: <%= pluginCmds[plugin.name].slashCount %></span
          >
        </div>
        <% if(enabledPlugins.includes(plugin.name)) { %>
        <a
          href="/dashboard/<%= guild.id %>/<%= plugin.name %>"
          class="border-primary-700 text-primary-700 hover:bg-primary-800 focus:ring-primary-300 dark:border-primary-500 dark:text-primary-500 dark:hover:bg-primary-500 dark:focus:ring-primary-800 inline-flex w-auto items-center rounded-lg border px-3 py-1 text-xs font-medium hover:text-white focus:outline-none focus:ring-4 dark:hover:text-white">
          <i class="fa-regular fa-circle-check text-blue me-2 h-3 w-3"></i>
          <%= tr('HOME.BTN_PLUGIN_ACTIVE') %>
        </a>
        <% } else { %>
        <button
          data-modal-target="modal-<%= plugin.name %>"
          data-modal-toggle="modal-<%= plugin.name %>"
          class="inline-flex w-auto items-center rounded-lg border border-green-700 px-3 py-1 text-xs font-medium text-green-700 hover:bg-green-800 hover:text-white focus:outline-none focus:ring-4 focus:ring-green-300 dark:border-green-500 dark:text-green-500 dark:hover:bg-green-500 dark:hover:text-white dark:focus:ring-green-800">
          <i class="fa-solid fa-plus text-green me-2 h-3 w-3"></i>
          <%= tr('HOME.BTN_PLUGIN_ENABLE') %>
        </button>
        <% } %>
      </div>
    </div>
    <% }) %>
  </div>

  <table
    x-show="view === 'list'"
    x-cloak
    class="min-w-full divide-y divide-gray-200 overflow-hidden rounded-xl bg-white shadow dark:divide-gray-700 dark:bg-gray-800">
    <thead class="bg-gray-50 dark:bg-gray-700">
      <tr>
        <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 dark:text-gray-300">Name</th>
        <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 dark:text-gray-300">Description</th>
        <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 dark:text-gray-300">Prefix</th>
        <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 dark:text-gray-300">Slash</th>
        <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 dark:text-gray-300">Version</th>
        <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 dark:text-gray-300">Action</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
      <% plugins.filter(p => !p.ownerOnly).forEach(plugin => { %>
      <tr>
        <td class="font-body px-4 py-2 text-gray-900 dark:text-white">
          <span class="text-sm font-medium text-gray-800 dark:text-gray-200">
            <%= plugin.name[0].toUpperCase() + plugin.name.slice(1) %>
          </span>
        </td>
        <td class="px-4 py-2 text-gray-600 dark:text-gray-300"><%= plugin.description %></td>
        <td class="px-4 py-2 text-gray-500 dark:text-gray-400"><%= pluginCmds[plugin.name].prefixCount %></td>
        <td class="px-4 py-2 text-gray-500 dark:text-gray-400"><%= pluginCmds[plugin.name].slashCount %></td>
        <td class="px-4 py-2 text-xs text-gray-800 dark:text-gray-300">v<%= plugin.version %></td>
        <td class="px-4 py-2">
          <% if(enabledPlugins.includes(plugin.name)) { %>
          <a
            href="/dashboard/<%= guild.id %>/<%= plugin.name %>"
            class="border-primary-700 text-primary-700 hover:bg-primary-800 focus:ring-primary-300 dark:border-primary-500 dark:text-primary-500 dark:hover:bg-primary-500 dark:focus:ring-primary-800 inline-flex items-center rounded-lg border px-3 py-1 text-xs font-medium hover:text-white focus:outline-none focus:ring-4 dark:hover:text-white">
            <i class="fa-regular fa-circle-check text-blue me-2 h-3 w-3"></i>
            <%= tr('HOME.BTN_PLUGIN_ACTIVE') %>
          </a>
          <% } else { %>
          <button
            data-modal-target="modal-<%= plugin.name %>"
            data-modal-toggle="modal-<%= plugin.name %>"
            class="inline-flex items-center rounded-lg border border-green-700 px-3 py-1 text-xs font-medium text-green-700 hover:bg-green-800 hover:text-white focus:outline-none focus:ring-4 focus:ring-green-300 dark:border-green-500 dark:text-green-500 dark:hover:bg-green-500 dark:hover:text-white dark:focus:ring-green-800">
            <i class="fa-solid fa-plus text-green me-2 h-3 w-3"></i>
            <%= tr('HOME.BTN_PLUGIN_ENABLE') %>
          </button>
          <% } %>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</section>

<% plugins.filter(p => !p.ownerOnly).forEach(plugin => { %> <% if(!enabledPlugins.includes(plugin.name)) { %>
<div
  id="modal-<%= plugin.name %>"
  tabindex="-1"
  class="fixed left-0 right-0 top-0 z-50 hidden h-[calc(100%-1rem)] max-h-full w-full items-center justify-center overflow-y-auto overflow-x-hidden md:inset-0">
  <div class="relative max-h-full w-full max-w-md p-4">
    <div class="relative rounded-lg bg-white shadow dark:bg-gray-700">
      <button
        type="button"
        class="absolute end-2.5 top-3 ms-auto inline-flex h-8 w-8 items-center justify-center rounded-lg bg-transparent text-sm text-gray-400 hover:bg-gray-200 hover:text-gray-900 dark:hover:bg-gray-600 dark:hover:text-white"
        data-modal-hide="modal-<%= plugin.name %>">
        <i class="fa-solid fa-xmark h-4 w-4"></i>
        <span class="sr-only">Close modal</span>
      </button>
      <div class="p-4 text-center md:p-5">
        <i class="fa-regular fa-circle-exclamation mb-3 h-12 w-12 dark:text-gray-200"></i>
        <h3 class="mb-5 text-lg font-normal text-gray-500 dark:text-gray-400">
          <%= tr('HOME.PLUGIN_ENABLE_CONFIRM') %>
        </h3>
        <form method="post">
          <input type="hidden" name="plugin_enable" value="<%= plugin.name %>" />
          <button
            data-modal-hide="modal-<%= plugin.name %>"
            type="submit"
            class="bg-primary-600 hover:bg-primary-800 focus:ring-primary-300 dark:focus:ring-primary-800 inline-flex items-center rounded-lg px-5 py-2.5 text-center text-sm font-medium text-white focus:outline-none focus:ring-4">
            <%= tr('HOME.PLUGIN_CONFIRM_YES') %>
          </button>
          <button
            data-modal-hide="modal-<%= plugin.name %>"
            type="button"
            class="hover:text-primary-700 ms-3 rounded-lg border border-gray-200 bg-white px-5 py-2.5 text-sm font-medium text-gray-900 hover:bg-gray-100 focus:z-10 focus:outline-none focus:ring-4 focus:ring-gray-100 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white dark:focus:ring-gray-700">
            <%= tr('HOME.PLUGIN_CONFIRM_NO') %>
          </button>
        </form>
      </div>
    </div>
  </div>
</div>
<% } %> <% }) %>
