<div class="grid gap-8 p-6" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));">
  <!-- With admin rights -->
  <% guilds.filter(g => g.admin && !g.settingsUrl.includes('discord.com')).forEach(guild => { %>
  <div
    class="relative flex w-full max-w-[24rem] min-w-[220px] flex-col rounded-2xl bg-white shadow-lg transition-transform duration-200 hover:scale-[1.03] hover:shadow-2xl dark:border-gray-700 dark:bg-gray-800 dark:hover:bg-gray-700 border border-gray-100">
    <img class="rounded-full mx-auto mt-4 mb-2 w-20 h-20 object-cover shadow-sm border-4 border-white dark:border-gray-700" src="<%= guild.iconURL %>" alt="" />
    <div class="flex flex-1 flex-col items-center justify-center p-6">
      <h4 class="mb-2 flex-1 font-semibold tracking-tight text-gray-900 dark:text-white text-lg text-center">
        <%= guild.name %>
      </h4>
      <a
        href="<%= guild.settingsUrl %>"
        class="flex w-full items-center justify-center rounded-lg bg-green-700 px-3 py-2 text-center text-sm font-medium text-white hover:bg-green-800 focus:outline-none focus:ring-4 focus:ring-green-300 dark:bg-green-600 dark:hover:bg-green-700 dark:focus:ring-green-800">
        <i class="fa-solid fa-gear mr-2 h-4 w-4"></i>
        <%= tr('SELECTOR.BTN_MANAGE') %>
      </a>
    </div>
  </div>
  <% }); %>

  <!-- Without admin rights -->
  <% guilds.filter(g => g.admin && g.settingsUrl.includes('discord.com')).forEach(guild => { %>
  <div
    class="relative flex w-full max-w-[24rem] min-w-[220px] flex-col rounded-2xl bg-white shadow-lg transition-transform duration-200 hover:scale-[1.03] hover:shadow-2xl dark:border-gray-700 dark:bg-gray-800 dark:hover:bg-gray-700 border border-gray-100">
    <img class="rounded-full mx-auto mt-4 mb-2 w-20 h-20 object-cover shadow-sm border-4 border-white dark:border-gray-700" src="<%= guild.iconURL %>" alt="" />
    <div class="flex flex-1 flex-col items-center justify-center p-6">
      <h4 class="mb-2 flex-1 font-semibold tracking-tight text-gray-900 dark:text-white text-lg text-center">
        <%= guild.name %>
      </h4>
      <a
        href="<%= guild.settingsUrl %>"
        class="flex w-full items-center justify-center rounded-lg bg-primary-700 px-3 py-2 text-center text-sm font-medium text-white hover:bg-primary-800 focus:outline-none focus:ring-4 focus:ring-primary-300 dark:bg-primary-600 dark:hover:bg-primary-700 dark:focus:ring-primary-800">
        <i class="fa-solid fa-paper-plane mr-2 h-4 w-4"></i>
        <%= tr('SELECTOR.BTN_INVITE') %>
      </a>
    </div>
  </div>
  <% }); %>
</div>
