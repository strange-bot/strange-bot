<div class="grid grid-cols-2 gap-4 p-4 sm:grid-cols-4 sm:p-2 md:grid-cols-4 md:p-4 lg:grid-cols-5">
  <!-- With admin rights -->
  <% user.guilds.filter(g => g.admin && !g.settingsUrl.includes('discord.com')).forEach(guild => { %>
  <div
    class="relative flex w-full max-w-[26rem] flex-col rounded-xl bg-white shadow-lg hover:bg-gray-100 dark:border-gray-700 dark:bg-gray-800 dark:hover:bg-gray-700">
    <img class="rounded-t-lg" src="<%= guild.iconURL %>" alt="" />
    <div class="flex flex-1 flex-col items-center justify-center p-5">
      <h4 class="mb-3 text-xl font-bold tracking-tight text-gray-900 dark:text-white"><%= guild.name %></h4>
      <a
        href="<%= guild.settingsUrl %>"
        class="flex w-full items-center justify-center rounded-lg bg-green-700 px-3 py-2 text-center text-sm font-medium text-white hover:bg-green-800 focus:outline-none focus:ring-4 focus:ring-green-300 dark:bg-green-600 dark:hover:bg-green-700 dark:focus:ring-green-800">
        <i class="fa-solid fa-gear mr-2 h-4 w-4"></i>
        <%= tr('dash:SELECTOR.BTN_MANAGE') %>
      </a>
    </div>
  </div>
  <% }); %>

  <!-- Without admin rights -->
  <% user.guilds.filter(g => g.admin && g.settingsUrl.includes('discord.com')).forEach(guild => { %>
  <div
    class="relative flex w-full max-w-[26rem] flex-col rounded-xl bg-white shadow-lg hover:bg-gray-100 dark:border-gray-700 dark:bg-gray-800 dark:hover:bg-gray-700">
    <img class="rounded-t-lg" src="<%= guild.iconURL %>" alt="" />
    <div class="flex flex-1 flex-col items-center justify-center p-5">
      <h4 class="mb-3 text-xl font-bold tracking-tight text-gray-900 dark:text-white"><%= guild.name %></h4>
      <a
        href="<%= guild.settingsUrl %>"
        class="flex w-full items-center justify-center rounded-lg bg-blue-700 px-3 py-2 text-center text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">
        <i class="fa-solid fa-paper-plane mr-2 h-4 w-4"></i>
        <%= tr('dash:SELECTOR.BTN_INVITE') %>
      </a>
    </div>
  </div>
  <% }); %>
</div>
