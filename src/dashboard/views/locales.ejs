<section class="px-4">
  <div
    class="flex items-center justify-between rounded-lg border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-gray-800 dark:text-white">
    <div>
      <h2 class="text-lg font-semibold text-gray-800 dark:text-white"><%= tr("dash:LOCALES_PAGE.TITLE") %></h2>
      <p class="text-sm text-gray-500"><%= tr("dash:LOCALES_PAGE.DESCRIPTION") %></p>
    </div>
    <div class="flex items-center space-x-4"></div>
  </div>
</section>

<section class="mb-6 px-4 pt-6">
  <div
    class="flex flex-col items-center justify-between rounded-lg border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-gray-800 dark:text-white">
    <!-- Filters -->
    <div class="mb-4 flex w-full flex-col md:flex-row">
      <!-- Plugin Filter -->
      <div class="mb-4 flex-1 md:mb-0 md:pr-2">
        <label for="plugin" class="mb-2 block text-sm font-medium text-gray-700 dark:text-white">
          <%= tr("dash:LOCALES_PAGE.PLUGIN_SELECT") %>:
        </label>
        <select
          id="plugin"
          name="plugin"
          class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2 text-xs text-gray-900 focus:border-primary-500 focus:ring-primary-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 dark:focus:border-primary-500 dark:focus:ring-primary-500 sm:p-2.5 sm:text-sm">
          <% for (let plugin of availablePlugins) { %>
          <option value="<%= plugin %>"><%= plugin %></option>
          <% } %>
        </select>
      </div>

      <!-- Language Filter -->
      <div class="flex-1">
        <label for="language" class="mb-2 block text-sm font-medium text-gray-700 dark:text-white">
          <%= tr("dash:LOCALES_PAGE.LOCALE_SELECT") %>:
        </label>
        <select
          id="language"
          name="language"
          class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2 text-xs text-gray-900 focus:border-primary-500 focus:ring-primary-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 dark:focus:border-primary-500 dark:focus:ring-primary-500 sm:p-2.5 sm:text-sm">
          <% for (let language of availableLanguages) { %>
          <option value="<%= language.value %>"><%= language.name %></option>
          <% } %>
        </select>
      </div>
    </div>

    <!-- Break -->
    <hr class="my-5 w-full border-t border-gray-200 dark:border-gray-700 md:hidden" />

    <!-- Localization Keys Section -->
    <div id="keysSection" class="mb-4 w-full">
      <!-- Localization keys will be dynamically generated here -->
    </div>

    <!-- Save Button -->
    <div
      class="mt-4 flex w-full items-center justify-between border-t border-gray-200 pt-3 dark:border-gray-700 sm:pt-6">
      <div></div>
      <div class="flex-shrink-0">
        <button
          type="button"
          id="saveBtn"
          name="saveBtn"
          class="inline-flex items-center rounded-lg bg-primary-700 px-3 py-2 text-center text-sm font-medium text-white hover:bg-primary-800 focus:outline-none focus:ring-4 focus:ring-primary-300 dark:bg-primary-600 dark:hover:bg-primary-700 dark:focus:ring-primary-800">
          <%= tr("common:DASH.UPDATE_ALL") %>
        </button>
      </div>
    </div>
  </div>
</section>
