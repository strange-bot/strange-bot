<!doctype html>
<html lang="en" class="dark">
  <head>
    <%- include('./partials/header.ejs') %>
  </head>

  <body class="bg-gray-50 dark:bg-gray-800">
    <%- include('./partials/navbar-dashboard.ejs') %>

    <div class="flex overflow-hidden bg-gray-50 pt-16 dark:bg-gray-900">
      <%- include('./partials/sidebar.ejs') %>

      <div id="main-content" class="relative h-full w-full overflow-y-auto bg-gray-50 dark:bg-gray-900 lg:ml-64">
        <main>
          <% if (locals.breadcrumb && locals.breadcrumb === true) { %> 
            <%- include('./partials/breadcrumb.ejs') %> 
          <% } %>

          <section class="px-4 pt-6">
            <div class="flex items-center justify-between rounded-lg bg-white p-4 shadow-sm dark:bg-gray-800 dark:text-white">
              <div class="flex items-center">
                <div class="icon-container bg-gray-300 dark:bg-gray-700 rounded-full h-12 w-12 flex items-center justify-center">
                  <i class="<%= plugin.icon %> text-gray-800 dark:text-white text-xl"></i>
                </div>
                <div class="ml-3">
                  <h2 class="text-lg font-semibold text-gray-800 dark:text-white"><%= tr(`${plugin.name}:TITLE`) %></h2>
                  <p class="text-sm text-gray-500"><%= tr(`${plugin.name}:DESCRIPTION`) %></p>
                </div>
              </div>

              <div>
                <% if (plugin.name !== "core") { %>
                <label class="relative flex cursor-pointer items-center">
                  <input type="checkbox" id="plugin-toggle" class="sr-only" <%= settings.enabled ? 'checked' : '' %>>
                  <span class="toggle-bg h-6 w-11 rounded-full border border-gray-200 bg-gray-200 dark:border-gray-600 dark:bg-gray-700"></span>
                </label>
                <% } %>
              </div>
            </div>
          </section>
          
          <section class="mb-6 px-4 pt-4">
            <div class="mb-4 border-b border-gray-200 dark:border-gray-700">
              <ul class="flex flex-wrap -mb-px text-sm font-medium text-center" id="default-tab" data-tabs-toggle="#default-tab-content" role="tablist">

                <!-- Settings Tab -->
                <li class="me-2" role="presentation">
                  <button class="inline-block p-4 border-b-2 rounded-t-lg" id="settings-tab" data-tabs-target="#settings" type="button" role="tab" aria-controls="settings" aria-selected="false"><%= tr("dash:TABS.SETTINGS") %></button>
                </li>

                <% if (locals.tabs && locals.tabs.length > 0) { %>
                  <!-- Custom Tabs -->
                  <% locals.tabs.forEach((tab) => { %>
                    <% const tabId = tab.replace(/ /g, "-").toLowerCase() %>
                    <li class="me-2" role="presentation">
                      <button class="inline-block p-4 border-b-2 rounded-t-lg hover:text-gray-600 hover:border-gray-300 dark:hover:text-gray-300" id="<%= tabId %>-tab" data-tabs-target="#<%= tabId %>" type="button" role="tab" aria-controls="<%= tabId %>" aria-selected="false"><%= tab %></button>
                    </li>
                  <% }) %>
                <% } %>

                <!-- Prefix Commands Tab -->
                <li class="me-2" role="presentation">
                  <button class="inline-block p-4 border-b-2 rounded-t-lg hover:text-gray-600 hover:border-gray-300 dark:hover:text-gray-300" id="commands-tab" data-tabs-target="#commands" type="button" role="tab" aria-controls="commands" aria-selected="false"><%= tr("dash:TABS.PREFIX") %></button>
                </li>

                <!-- Slash Commands Tab -->
                <li class="me-2" role="presentation">
                  <button class="inline-block p-4 border-b-2 rounded-t-lg hover:text-gray-600 hover:border-gray-300 dark:hover:text-gray-300" id="slash-commands-tab" data-tabs-target="#slash-commands" type="button" role="tab" aria-controls="slash-commands" aria-selected="false"><%= tr("dash:TABS.SLASH") %></button>
                </li>

              </ul>
            </div>
            <div id="default-tab-content">

              <!-- Settings Tab Content -->
              <div class="hidden p-4 rounded-lg bg-gray-50 dark:bg-gray-800" id="settings" role="tabpanel" aria-labelledby="settings-tab">
                <%- body %>
              </div>

              <% if (locals.tabs && locals.tabs.length > 0) { %>
                <!-- Custom Tabs Content -->
                <% locals.tabs.forEach((tab) => { %>
                  <% const tabId = tab.replace(/ /g, "-").toLowerCase() %>
                  <div class="hidden p-4 rounded-lg bg-gray-50 dark:bg-gray-800" id="<%= tabId %>" role="tabpanel" aria-labelledby="<%= tabId %>-tab">
                    <%- locals[tab] %>
                  </div>
                <% }) %>
              <% } %>

              <!-- Prefix Commands Tab Content -->
              <div class="hidden p-4 rounded-lg bg-gray-50 dark:bg-gray-800" id="commands" role="tabpanel" aria-labelledby="commands-tab">
                <form method="post">
                  <div class="mb-3">
                  <% plugin.commands.forEach((cmd) => { %>
                    <% if (cmd.command?.enabled) { %>

                    <div class="mb-3 flex items-center justify-between">
                      <div class="flex flex-grow flex-col">
                        <div class="mb-1 text-sm font-semibold text-gray-900 dark:text-white"><%= cmd.name %></div>
                        <div class="text-sm font-normal text-gray-500 dark:text-gray-400">
                          <%= tr(cmd.description) %>
                        </div>
                      </div>
                      <label for="<%= cmd.name %>" class="relative flex cursor-pointer items-center">
                        <% if (!coreSettings.disabled_prefix.includes(cmd.name)) { %>
                          <input type="checkbox" name="<%= cmd.name %>" id="<%= cmd.name %>" class="sr-only" checked />
                        <% } else { %>
                          <input type="checkbox" name="<%= cmd.name %>" id="<%= cmd.name %>" class="sr-only" />
                        <% } %>
                        <span class="toggle-bg h-6 w-11 rounded-full border border-gray-200 bg-gray-200 dark:border-gray-600 dark:bg-gray-700"></span>
                      </label>
                    </div>

                    <% } %>
                  <% }) %>
                  </div>

                  <div class="mt-4 flex items-center justify-between border-t border-gray-200 pt-3 dark:border-gray-700 sm:pt-6">
                    <div></div>
                    <div class="flex-shrink-0">
                      <button
                        type="submit"
                        name="prefix_commands_toggle"
                        class="inline-flex items-center rounded-lg bg-blue-700 px-3 py-2 text-center text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">
                        <%= tr("common:DASH.SAVE") %>
                      </button>
                    </div>
                  </div>
                </form>
              </div>

              <!-- Slash Commands Tab Content -->
              <div class="hidden p-4 rounded-lg bg-gray-50 dark:bg-gray-800" id="slash-commands" role="tabpanel" aria-labelledby="slash-commands-tab">
                <form method="post">
                  <div class="mb-3">
                  <% plugin.commands.forEach((cmd) => { %>
                    <% if (cmd.slashCommand?.enabled) { %>

                    <div class="mb-3 flex items-center justify-between">
                      <div class="flex flex-grow flex-col">
                        <div class="mb-1 text-sm font-semibold text-gray-900 dark:text-white">/<%= cmd.name %></div>
                        <div class="text-sm font-normal text-gray-500 dark:text-gray-400">
                          <%= tr(cmd.description) %>
                        </div>
                      </div>
                      <label for="<%= cmd.name %>" class="relative flex cursor-pointer items-center">
                        <% if (!coreSettings.disabled_slash.includes(cmd.name)) { %>
                          <input type="checkbox" name="<%= cmd.name %>" id="<%= cmd.name %>" class="sr-only" checked />
                        <% } else { %>
                          <input type="checkbox" name="<%= cmd.name %>" id="<%= cmd.name %>" class="sr-only" />
                        <% } %>
                        <span class="toggle-bg h-6 w-11 rounded-full border border-gray-200 bg-gray-200 dark:border-gray-600 dark:bg-gray-700"></span>
                      </label>
                    </div>

                    <% } %>
                  <% }) %>
                  </div>

                  <div class="mt-4 flex items-center justify-between border-t border-gray-200 pt-3 dark:border-gray-700 sm:pt-6">
                    <div></div>
                    <div class="flex-shrink-0">
                      <button
                        type="submit"
                        name="slash_commands_toggle"
                        class="inline-flex items-center rounded-lg bg-blue-700 px-3 py-2 text-center text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">
                        <%= tr("common:DASH.SAVE") %>
                      </button>
                    </div>
                  </div>
                </form>
              </div>
              
            </div>
          </section>
        </main>

        <% if (locals.footer && locals.footer === true) { %>
          <%- include('./partials/footer.ejs') %> 
        <% } %>
      </div>
    </div>

    <%- include('./partials/scripts.ejs') %>
  </body>
</html>
