<div class="px-4 pt-6">
  <nav
    class="flex rounded-lg border border-gray-200 bg-white px-5 py-3 text-gray-700 dark:border-gray-700 dark:bg-gray-800"
    aria-label="Breadcrumb">
    <ol class="inline-flex items-center space-x-1 md:space-x-2 rtl:space-x-reverse">
      <li class="inline-flex items-center">
        <a
          href="/dashboard"
          class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-primary-600 dark:text-gray-400 dark:hover:text-white">
          <i class="fas fa-home me-2.5 h-3 w-3" aria-hidden="true"></i>
          <%= tr('dash:SIDEBAR.SELECTOR') %>
        </a>
      </li>

      <% if (locals.guild) { %>
      <li aria-current="page">
        <div class="flex items-center">
          <i class="fas fa-chevron-right mx-1 h-3 w-3 text-gray-400" aria-hidden="true"></i>
          <a
            href="/dashboard/<%=guild.id%>"
            class="ms-1 text-sm font-medium text-gray-700 hover:text-primary-600 dark:text-gray-400 dark:hover:text-white md:ms-2"
            ><%=guild.name%></a
          >
        </div>
      </li>
      <% } %> <% if (locals.plugin) { %>
      <li aria-current="page">
        <div class="flex items-center">
          <i class="fas fa-chevron-right mx-1 h-3 w-3 text-gray-400" aria-hidden="true"></i>
          <% const name = plugin.name.charAt(0).toUpperCase() + plugin.name.slice(1); %>
          <span class="ms-1 text-sm font-medium text-gray-500 dark:text-gray-400 md:ms-2"><%=name%></span>
        </div>
      </li>
      <% } %>
    </ol>
  </nav>
</div>
