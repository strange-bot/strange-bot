              </svg>
              <span class="ml-3" sidebar-toggle-item><%= tr('dash:SIDEBAR.LOCALES') %></span>
            </a>
          </li>

          <% if (locals.plugins) { %>
            
            <li>
              <button
                type="button"
                class="group flex w-full items-center rounded-lg p-2 text-base text-gray-900 transition duration-75 hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-700"
                aria-controls="dropdown-plugins"
                data-collapse-toggle="dropdown-plugins">
                <svg
                  class="h-6 w-6 flex-shrink-0 text-gray-500 transition duration-75 group-hover:text-gray-900 dark:text-gray-400 dark:group-hover:text-white"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                  xmlns="http://www.w3.org/2000/svg"
                  aria-hidden="true">
                  <path
                    d="M3 4a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1V4zM3 10a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H4a1 1 0 01-1-1v-6zM14 9a1 1 0 00-1 1v6a1 1 0 001 1h2a1 1 0 001-1v-6a1 1 0 00-1-1h-2z"></path>
                </svg>
                <span class="ml-3 flex-1 whitespace-nowrap text-left" sidebar-toggle-item><%= tr('dash:SIDEBAR.PLUGINS') %></span>
                <svg
                  sidebar-toggle-item
                  class="h-6 w-6"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                  xmlns="http://www.w3.org/2000/svg">
                  <path
                    fill-rule="evenodd"
                    d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"
                    clip-rule="evenodd"></path>
                </svg>
              </button>
              <ul id="dropdown-plugins" class="space-y-2 py-2 <% if (!slug.includes('plugins')) { %>hidden<% }%>">
                <% for (let i = 0; i < plugins.length; i++) { %> 
                  <% let urlName = plugins[i].name %> 
                  <% let name =plugins[i].name.charAt(0).toUpperCase() + plugins[i].name.slice(1).toLowerCase() %>
                <li <% if (slug.includes(plugins[i].name)) { %>id="aside-active-item"<% }%>>
                  <a
                    href="/admin/<%=urlName%>"
                    class="group flex items-center rounded-lg p-2 pl-11 text-base text-gray-900 transition duration-75 hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-700 <% if (slug.includes(plugins[i].name)) { %>bg-gray-100 dark:bg-gray-700<% }%>"
                    ><%=name%></a
                  >
                </li>
                <% } %>
              </ul>
            </li>

          <% } %>
        </ul>
      </div>
    </div>
    <div
